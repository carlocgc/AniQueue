<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure tests: no database, no network, no disk. These should stay fast enough
       to run on every save in Visual Studio's Test Explorer. -->

  <!-- The AniList fixture is embedded rather than copied to the output directory:
       it is then read from memory, and no test needs to know where it landed
       relative to the runner's working directory. -->
  <ItemGroup>
    <EmbeddedResource Include="Import\Fixtures\*.json" />
    <EmbeddedResource Include="Sync\Fixtures\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AniQueue.Core\AniQueue.Core.csproj" />
  </ItemGroup>

</Project>
