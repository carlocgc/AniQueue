<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests against real EF Core and real SQLite. The EF InMemory
       provider is deliberately not used anywhere: it does not enforce the
       constraints these tests exist to verify. -->

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The settings tests build a real configuration chain with the real JSON provider,
      because what that provider accepts is the contract userconfig.json is written
      against and a second implementation of ours could disagree with it (D20, D36).

      A FrameworkReference rather than a PackageReference: Microsoft.Extensions
      .Configuration.Json ships inside the ASP.NET Core shared framework that is
      already installed to run this application, so this costs no new package and §12
      has nothing to approve.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AniQueue.Core\AniQueue.Core.csproj" />
    <ProjectReference Include="..\..\src\AniQueue.Infrastructure\AniQueue.Infrastructure.csproj" />
  </ItemGroup>

</Project>
