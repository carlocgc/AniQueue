@using System.Globalization
@using AniQueue.Core.Artwork
@using AniQueue.Core.Domain
@using AniQueue.Core.Library
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    The case for one title (D49).

    The first surface in this application whose job is persuasion rather than
    administration, and the narrowness of that job is what decides its contents: it
    exists to make an unwatched title look worth queueing. Everything on it either
    argues for the show or says why the model thinks you would like it.

    Every field degrades to absent. A title with no synopsis, no genres, no main
    studio or no poster shows less rather than showing a placeholder — D25's rule,
    which the art path has followed since 9a and which most titles will exercise:
    a MyAnimeList-only import has none of this at all.
*@

<dialog @ref="_dialog" class="detail-dialog" aria-labelledby="detail-dialog-title" @onclose="OnClosed">
    @if (_detail is { } detail)
    {
        <article>
            <header>
                <h2 id="detail-dialog-title">@detail.Title</h2>

                @* Autofocus so the platform's own focus move on showModal lands on
                   the control that dismisses, which is what a keyboard user reaches
                   for first and what a screen reader announces on open. *@
                <button class="icon detail-close" autofocus aria-label="Close" @onclick="CloseAsync">✕</button>
            </header>

            <div class="detail-body">
                <div class="detail-art">
                    @* The full-size rendition where it has arrived, the list's own
                       thumbnail while it has not, then the colour block. The middle
                       step matters more than it looks: a fresh install has thumbnails
                       for several minutes before it has posters (D48), and a dialog
                       showing a colour block beside a list row showing art for the
                       same title would read as broken rather than as pending. *@
                    <span class="detail-poster @(detail.Poster.HasImage ? null : "detail-poster-blank") @(detail.Poster.IsEmpty ? "detail-poster-empty" : null)"
                          style="@PosterColour(detail)"
                          aria-hidden="true">
                        @if (detail.Poster.HasImage)
                        {
                            @* No height attribute, deliberately. AniList fixes the
                               width of this rendition and lets the height vary per
                               title, so stating one would be wrong for most of the
                               library and would crop the art to fit the lie. *@
                            <img src="@detail.Poster.Url" alt="" width="230" decoding="async" />
                        }
                    </span>
                </div>

                <div class="detail-facts">
                    <p class="detail-meta">
                        @foreach (var fact in Facts(detail))
                        {
                            <span>@fact</span>
                        }
                    </p>

                    @if (detail.MainStudio is { Length: > 0 } studio)
                    {
                        <p class="detail-studio">@studio</p>
                    }

                    @if (detail.Genres.Count > 0)
                    {
                        <ul class="detail-genres">
                            @foreach (var genre in detail.Genres)
                            {
                                <li>@genre</li>
                            }
                        </ul>
                    }

                    @* Side by side because they are the same measurement of the same
                       title from two different judges, and directly comparable: every
                       parser normalises an incoming score into 1–10 on the way in, and
                       ScoringScale.Default is the same 1–10 the model is asked for. If
                       those ever diverged this pairing would start lying, which is why
                       it is written down here rather than assumed. *@
                    @if (detail.UserScore is not null || detail.RecommendationScore is not null)
                    {
                        <div class="detail-scores">
                            @* Shown whenever there is one, rather than only when the
                               title is Completed. A score exists because the user gave
                               it, and they can rate something they dropped or put on
                               hold — hiding it there would be withholding their own
                               judgement on a screen built to inform one. *@
                            @if (detail.UserScore is { } userScore)
                            {
                                <div class="detail-stat">
                                    <span class="detail-stat-label">Your score</span>
                                    <span class="detail-stat-value">@userScore</span>
                                </div>
                            }

                            @if (detail.RecommendationScore is { } score)
                            {
                                <div class="detail-stat">
                                    <span class="detail-stat-label">AI score</span>
                                    <span class="detail-stat-value">@score.ToString("0.0")</span>
                                    @if (detail.RecommendationConfidence is { } confidence)
                                    {
                                        <span class="detail-stat-note">@Percent(confidence) confident</span>
                                    }
                                </div>
                            }
                        </div>

                        @* Verbatim and encoded, like every other string a model
                           produced. Blazor escapes it; nothing here builds markup. *@
                        @if (detail.RecommendationReason is { Length: > 0 } reason)
                        {
                            <p class="detail-reason">@reason</p>
                        }
                    }
                </div>
            </div>

            @if (detail.SynopsisSegments.Count > 0)
            {
                <div class="detail-synopsis">
                    @foreach (var segment in detail.SynopsisSegments)
                    {
                        @if (segment.IsSpoiler)
                        {
                            @* A button rather than a span, because revealing is an
                               action and a keyboard has to be able to take it. Once
                               revealed it stays revealed for as long as the dialog is
                               open, which is the whole of the state this needs. *@
                            <button type="button"
                                    class="spoiler @(_revealed ? "revealed" : null)"
                                    aria-expanded="@_revealed.ToString().ToLowerInvariant()"
                                    aria-label="@(_revealed ? null : "Reveal spoiler")"
                                    @onclick="() => _revealed = true">@segment.Text</button>
                        }
                        else
                        {
                            <span>@segment.Text</span>
                        }
                    }
                </div>
            }

            @if (detail.SourceLinks.Count > 0)
            {
                <footer class="detail-links">
                    @foreach (var link in detail.SourceLinks)
                    {
                        <a href="@link.Url"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="@link.DescribeFor(detail.Title)">@link.ShortName ↗</a>
                    }
                </footer>
            }
        </article>
    }
</dialog>

@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private TitleDetail? _detail;
    private bool _revealed;
    private bool _opening;

    /// <summary>Loads and shows one title. Does nothing if it has since gone.</summary>
    /// <remarks>
    /// The load happens before the dialog opens rather than after, so it never
    /// appears empty and then fills in. It is one title read at human speed, which is
    /// what makes that affordable — and a title deleted by a sync between the click
    /// and this call simply does not open, because there is nothing to argue about
    /// and an error would be about our timing rather than about anything they did.
    /// </remarks>
    public async Task ShowAsync(TitleDetail? detail)
    {
        if (detail is null || _opening)
        {
            return;
        }

        _opening = true;

        try
        {
            _detail = detail;
            _revealed = false;

            // Rendered before showModal, so the dialog the platform focuses into
            // already has the close button inside it.
            StateHasChanged();

            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Shared/ShowDetailDialog.razor.js");

            await _module.InvokeVoidAsync("showModal", _dialog);
        }
        finally
        {
            _opening = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }
    }

    /// <summary>
    /// Drops the closed title, however the dialog was dismissed.
    /// </summary>
    /// <remarks>
    /// <b>Nothing depends on this running.</b> <see cref="ShowAsync"/> sets both
    /// fields and renders before it calls <c>showModal</c>, so the dialog is always
    /// correct by the time it is visible whether or not this fires. It is here to
    /// stop a closed dialog holding the last title's text in the DOM indefinitely,
    /// which is tidiness rather than correctness — and the distinction is deliberate,
    /// because two of the three ways to close (Escape, the backdrop) never pass
    /// through <see cref="CloseAsync"/> at all.
    ///
    /// <b>It could not be verified.</b> The browser this was driven through fires no
    /// <c>close</c> event even for a bare dialog created and closed in one statement,
    /// so whether Blazor's handler is reached is untested — hence making the component
    /// correct without it rather than relying on it.
    /// </remarks>
    private void OnClosed()
    {
        _detail = null;
        _revealed = false;
    }

    /// <summary>The facts that fit on one line, with the ones that are unknown left out.</summary>
    private static IEnumerable<string> Facts(TitleDetail detail)
    {
        if (detail.MediaType != MediaType.Unknown)
        {
            yield return detail.MediaType.ToString().ToUpperInvariant();
        }

        if (detail.ReleaseYear is { } year)
        {
            yield return year.ToString(CultureInfo.InvariantCulture);
        }

        if (detail.EpisodeCount is { } episodes and > 0)
        {
            yield return episodes == 1 ? "1 episode" : $"{episodes} episodes";
        }

        if (RuntimeCalculator.Format(detail.EstimatedRuntimeMinutes) is { } runtime)
        {
            yield return runtime;
        }
    }

    /// <summary>The same rounding the backlog's own confidence column uses.</summary>
    private static string Percent(double value) =>
        ((int)Math.Round(value * 100)).ToString(CultureInfo.CurrentCulture) + "%";

    private static string? PosterColour(TitleDetail detail) =>
        detail.Poster.Colour is { } colour ? $"--cover-colour: {colour}" : null;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went before the module could be released, which is the
                // ordinary way a page ends. There is nothing on the other side to
                // dispose and nothing here worth logging.
            }
        }
    }
}
