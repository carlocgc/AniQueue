@* The preview, rendered. Shared because this is the review surface for a
   sync as well as for an upload: an unattended run holds its conflicts, and what
   the user comes back to is this page's tables recomputed from a fresh fetch.

   Deliberately no confirm or cancel button. What committing means differs between
   an uploaded file and a sync — the wording, what happens afterwards, where the
   user goes next — so each page keeps its own toolbar and this component keeps the
   part that is genuinely identical. *@

@if (Preview is { IsFileRejected: false } preview)
{
    <div class="stat-row">
        <div class="stat"><div class="value">@preview.CreateCount</div><div class="label">New</div></div>
        <div class="stat"><div class="value">@preview.UpdateCount</div><div class="label">Updated</div></div>
        <div class="stat"><div class="value">@preview.UnchangedCount</div><div class="label">Unchanged</div></div>
        <div class="stat"><div class="value">@preview.ConflictCount</div><div class="label">Conflicts</div></div>
        <div class="stat"><div class="value">@preview.InvalidCount</div><div class="label">Invalid</div></div>
    </div>

    @* The page's own summary and confirm controls, between the headline figures and
       the detail. Above the conflicts deliberately: the user should meet what they
       are being asked to confirm before scrolling through several screens of it. *@
    @Actions

    @if (preview.ConflictCount > 0)
    {
        @* Tinted while it is still asking; once the decisions are made and applied it
           is a report like everything else, so it stops shouting. *@
        <div class="card @(IsEditable ? "needs-decision" : null)">
            @if (IsEditable)
            {
                <h2>Conflicts — @preview.ConflictCount needing a decision</h2>
                <p class="muted">
                    AniQueue will not merge entries it cannot confidently identify, because an
                    incorrect merge is much harder to undo than a skipped row. You know whether
                    these are the same title, so the choice is yours. Skipping changes nothing.
                </p>
            }
            else
            {
                <h2>Conflicts — @preview.ConflictCount, and what was decided</h2>
                <p class="muted">
                    These could not be confidently identified, so each one was handled the way
                    the Action column records. Anything skipped is unchanged and will be asked
                    about again next time.
                </p>
            }

            @if (IsEditable)
            {
                <div class="toolbar">
                    <span class="muted">Set all to:</span>
                    <button class="choice skip" @onclick="() => SetAllConflicts(ConflictResolution.Skip)">Skip</button>
                    <button class="choice link" @onclick="() => SetAllConflicts(ConflictResolution.LinkToExisting)">Link to existing</button>
                    <button class="choice new" @onclick="() => SetAllConflicts(ConflictResolution.ImportAsNew)">Import as new</button>
                </div>

                @* Says what confirming will actually do, so the decision does not have
                   to be reconstructed by reading down the Action column. *@
                <p class="muted">
                    <strong>@ConflictPlanText(preview)</strong>
                </p>
            }

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Incoming title</th>
                            <th>Already in library</th>
                            <th>Why</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in preview.Items.Where(i => i.Action == ImportAction.Conflict))
                        {
                            <tr>
                                <td>@item.Entry.Title</td>
                                <td class="muted">@(item.ExistingTitle ?? "—")</td>
                                <td class="muted">@item.ConflictReason</td>
                                <td>
                                    @if (IsEditable)
                                    {
                                        @* Coloured by what the choice does, using the same
                                           language as the action badges: green adds, amber
                                           modifies something that already exists, neutral
                                           changes nothing. Amber on "link" is deliberate —
                                           it rewrites an existing record and is the hardest
                                           of the three to undo. *@
                                        <select class="resolution @ResolutionClass(item.Resolution)"
                                                value="@item.Resolution"
                                                @onchange="e => SetResolution(item, e)"
                                                aria-label="@($"How to handle {item.Entry.Title}")">
                                            <option value="@ConflictResolution.Skip">Skip — no change</option>
                                            @if (item.ExistingAnimeId is not null)
                                            {
                                                <option value="@ConflictResolution.LinkToExisting">Link to existing — rewrites it</option>
                                            }
                                            <option value="@ConflictResolution.ImportAsNew">Import as new — adds a copy</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge @ResolutionClass(item.Resolution)">@ResolutionText(item.Resolution)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (IsEditable)
            {
                <p class="muted">
                    <strong>Link to existing</strong> treats them as the same title: the existing
                    entry adopts the incoming identifier and progress, so it will match cleanly
                    every time after this. <strong>Import as new</strong> adds a separate entry.
                </p>
            }
        </div>
    }

    @if (preview.Problems.Count > 0)
    {
        <div class="card">
            <h2>Problems</h2>
            <ul class="muted">
                @foreach (var problem in preview.Problems.Take(50))
                {
                    <li>@problem.ToString()</li>
                }
            </ul>
            @if (preview.Problems.Count > 50)
            {
                <p class="muted">…and @(preview.Problems.Count - 50) more.</p>
            }
        </div>
    }

    <div class="card">
        @{
            var changing = preview.Items
                .Where(i => i.Action is ImportAction.Create or ImportAction.Update)
                .ToList();
            var totalPages = Math.Max(1, (changing.Count + PageSize - 1) / PageSize);
            _changesPage = Math.Clamp(_changesPage, 0, totalPages - 1);
            var visible = changing.Skip(_changesPage * PageSize).Take(PageSize).ToList();
        }

        <h2>Changes — @changing.Count</h2>

        @if (changing.Count == 0)
        {
            <p class="empty-state">No entries would be created or updated.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Action</th><th>Title</th><th>Status</th>
                            <th class="numeric">Score</th><th>Changes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in visible)
                        {
                            <tr>
                                <td><span class="badge @item.Action.ToString().ToLowerInvariant()">@item.Action</span></td>
                                <td>@item.Entry.Title</td>
                                <td>@item.Entry.Status</td>
                                <td class="numeric">@(item.Entry.UserScore?.ToString() ?? "—")</td>
                                <td class="muted">@string.Join("; ", item.Changes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Paged rather than truncated. A real list runs to several hundred
               entries, and "showing the first 200" leaves the rest unreviewable
               before confirming a change to the whole library. *@
            @if (totalPages > 1)
            {
                <div class="toolbar">
                    <button @onclick="() => _changesPage = 0" disabled="@(_changesPage == 0)">First</button>
                    <button @onclick="() => _changesPage--" disabled="@(_changesPage == 0)">Previous</button>
                    <span class="muted">
                        @(_changesPage * PageSize + 1)–@Math.Min((_changesPage + 1) * PageSize, changing.Count)
                        of @changing.Count
                    </span>
                    <button @onclick="() => _changesPage++" disabled="@(_changesPage >= totalPages - 1)">Next</button>
                    <button @onclick="() => _changesPage = totalPages - 1" disabled="@(_changesPage >= totalPages - 1)">Last</button>
                </div>
            }
        }
    </div>
}

@code {
    private const int PageSize = 100;

    private int _changesPage;

    [Parameter, EditorRequired]
    public required ImportPreview? Preview { get; set; }

    /// <summary>
    /// Whether conflict resolutions can still be changed. False once the preview has
    /// been applied, when the same tables become the record of what was decided.
    /// </summary>
    [Parameter]
    public bool IsEditable { get; set; } = true;

    /// <summary>
    /// The owning page's summary and confirm controls, rendered under the figures.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private void SetResolution(ImportPreviewItem item, ChangeEventArgs e)
    {
        if (Enum.TryParse<ConflictResolution>(e.Value?.ToString(), out var resolution))
        {
            item.Resolution = resolution;
        }
    }

    private void SetAllConflicts(ConflictResolution resolution)
    {
        if (Preview is null)
        {
            return;
        }

        foreach (var item in Preview.Items.Where(i => i.Action == ImportAction.Conflict))
        {
            // Only offer linking where there is something to link to.
            item.Resolution = resolution == ConflictResolution.LinkToExisting && item.ExistingAnimeId is null
                ? ConflictResolution.Skip
                : resolution;
        }
    }

    /// <summary>
    /// Maps a resolution onto the page's existing colour language: "new" adds and is
    /// green like Create, "link" rewrites an existing record and is amber like Update,
    /// "skip" changes nothing and stays neutral.
    /// </summary>
    private static string ResolutionClass(ConflictResolution resolution) => resolution switch
    {
        ConflictResolution.LinkToExisting => "link",
        ConflictResolution.ImportAsNew => "new",
        _ => "skip"
    };

    /// <summary>
    /// What was done with a conflict, in words and in the past tense.
    /// </summary>
    /// <remarks>
    /// The enum name reached the page as <c>LinkToExisting</c>, which is neither
    /// English nor what the reader was offered: the control above spells the same
    /// three choices out. This is a record of a decision already applied, so it
    /// reads as one.
    /// </remarks>
    private static string ResolutionText(ConflictResolution resolution) => resolution switch
    {
        ConflictResolution.LinkToExisting => "Linked to existing",
        ConflictResolution.ImportAsNew => "Added separately",
        _ => "Skipped"
    };

    private static string ConflictPlanText(ImportPreview preview)
    {
        var conflicts = preview.Items.Where(i => i.Action == ImportAction.Conflict).ToList();
        var skip = conflicts.Count(i => i.Resolution == ConflictResolution.Skip);
        var link = conflicts.Count(i => i.Resolution == ConflictResolution.LinkToExisting);
        var create = conflicts.Count(i => i.Resolution == ConflictResolution.ImportAsNew);

        if (skip == conflicts.Count)
        {
            return "All conflicts will be skipped — nothing about them changes.";
        }

        var parts = new List<string>();
        if (link > 0)
        {
            parts.Add($"{link} existing {(link == 1 ? "entry" : "entries")} rewritten");
        }

        if (create > 0)
        {
            parts.Add($"{create} added as {(create == 1 ? "a copy" : "copies")}");
        }

        if (skip > 0)
        {
            parts.Add($"{skip} skipped");
        }

        return $"On confirming: {string.Join(", ", parts)}.";
    }
}
