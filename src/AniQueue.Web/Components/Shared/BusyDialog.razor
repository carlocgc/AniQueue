@using AniQueue.Web.Services

@* Presentational only. All timing rules live in BusyScope so that every
   long-running operation in the application behaves identically. *@

@if (State.IsVisible)
{
    <div class="busy-overlay" role="alertdialog" aria-modal="true" aria-busy="true"
         aria-labelledby="busy-title" aria-describedby="busy-status">
        <div class="busy-panel">
            <div class="spinner" aria-hidden="true"></div>

            <h2 id="busy-title">@State.Title</h2>

            @* aria-live rather than the dialog label, so a screen reader announces
               each step as it changes instead of only on open. *@
            <p id="busy-status" aria-live="polite">@State.Message</p>

            @if (State.Fraction is { } fraction)
            {
                <div class="progress busy-progress"
                     role="progressbar"
                     aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="@((int)(fraction * 100))">
                    <span style="width: @(((int)(fraction * 100)).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                </div>
                <p class="muted busy-count">@State.CountText</p>
            }

            @* Completed steps stay listed. They are what makes the dialog worth
               reading rather than a spinner with a caption. *@
            @if (State.CompletedSteps.Count > 0)
            {
                <ul class="busy-steps">
                    @foreach (var step in State.CompletedSteps)
                    {
                        <li>@step</li>
                    }
                </ul>
            }

            @* A cancel button was here, rendered only when an operation supplied a
               callback. Its own comment said why it was rare: every operation with a
               dialog could not usefully be interrupted — an import is committing rows,
               a sync is reconciling them — and offering to stop one raises a question
               about what half-done means. Waiting on somebody else's model was "the
               first thing here where stopping is free and the wait can be long enough
               to want to".

               It was also the last. D42 deleted that wait, so every operation behind
               this dialog is once again one that should not be interrupted, and the
               dialog goes back to having no way out. Stopping background work is the
               tasks page's job, where the thing being stopped is not something
               somebody is standing in front of. *@
        </div>
    </div>
}

@code {
    /// <summary>The scope driving this dialog. Owned by the page.</summary>
    [Parameter, EditorRequired]
    public required BusyScope State { get; set; }

    // OnCancel, CancelLabel and the latch that stopped a second press were here. The
    // latch is worth remembering rather than just deleting: cancelling was not instant
    // — an HTTP call in flight is abandoned rather than undone — so the button had to
    // go quiet and say "Stopping…" on its own, because the work reported nothing more
    // once it had been told to stop. The tasks page repeats that shape for the same
    // reason (D42).
}
