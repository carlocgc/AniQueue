@page "/sources"
@implements IDisposable
@using AniQueue.Core.Settings
@using AniQueue.Infrastructure.Sync
@using Microsoft.Extensions.Options
@inject IUserSettingsStore Settings
@inject ISyncService SyncService
@inject IImportService ImportService
@inject IRelationBackfill RelationBackfill
@inject ILibraryChangeNotifier Changes
@inject IOptionsMonitor<SyncOptions> SyncConfiguration
@inject ILogger<Sources> Logger

<PageTitle>Sources — AniQueue</PageTitle>

@* Confirmations only, and this is the page that needed one most: several controls
   here save the moment they are changed, so until now a setting that worked and a
   setting that did nothing looked exactly alike. *@
<Toast State="_toasts" />

<div class="page-header">
    <h1>Sources</h1>
    <p>
        Where your library comes from. Syncing reads only — AniQueue never writes
        anything back to your account.
    </p>
</div>

@if (_error is not null)
{
    <div class="notice error" role="alert">@_error</div>
}

@* A finished sync reports at the top, where the button that started it is, rather
   than below the source cards. There is nothing to scroll to — the result *is*
   that no tables appeared — so a message further down the page reads as the click
   having done nothing at all. *@
@if (_nothingToDo)
{
    <div class="notice success" role="status">
        Already up to date — your library matches this source, so there is nothing to apply.
    </div>
}

@if (!SyncConfiguration.CurrentValue.Enabled)
{
    @* The operator's kill switch. Said out loud because otherwise a Sync Now that
       refuses looks like a broken button rather than a deliberate setting. *@
    <div class="notice info" role="status">
        Syncing is turned off in this deployment's configuration
        (<code>Sync:Enabled</code>). Nothing here will fetch until it is turned
        back on.
    </div>
}

@* Once a preview is on screen the source cards are no longer what the page is
   about, and they are tall — account line, failure and absence notices, relation
   coverage, settings — so leaving them expanded puts the answer to "what would this
   change" several scrolls below the button that asked. The one card that produced
   the preview collapses to a heading and the way out; the rest are not drawn at all.
   See VisibleSources. *@
@foreach (var status in VisibleSources)
{
    <div class="card @(IsPreviewing ? "collapsed" : null)">
        <h2>@status.Source</h2>

        @* Previewing is asked first, before anything about the source's kind, because
           at that point the card is one thing regardless: a heading and the way out.

           Discarding is how a preview ends — syncing over one threw it away without
           saying so, and with it every conflict the user had just resolved in an
           editable surface. Sync now, or the file picker, comes back the moment it is
           pressed. *@
        @if (IsPreviewing)
        {
            <div class="toolbar">
                <button @onclick="Reset" disabled="@_busy.IsRunning">Discard this preview</button>
            </div>
        }
        else if (!status.IsConfigured)
        {
            @* Editable here rather than only in a file, which D36 changed: an account
               name is the first thing a new installation needs and "edit some JSON and
               restart" is a poor first screen. The file stays the way in when this page
               cannot be reached — the same value, the same key, one home. *@
            <p class="muted">
                No account is configured yet. AniQueue reads a public AniList list; it does
                not sign in, and has no password for your account.
            </p>

            <div class="field">
                <label for="anilist-account">AniList username</label>
                <input id="anilist-account" type="text" maxlength="60" spellcheck="false"
                       placeholder="Your AniList username" disabled="@_busy.IsRunning"
                       @bind="_aniListAccount" @bind:event="oninput"
                       @onkeydown="OnAccountKeyDownAsync" />
                <p class="muted">
                    Saved to <code>@Settings.Path</code>, which is also where you can change
                    it by hand if this page is ever unreachable.
                </p>
            </div>

            <div class="toolbar">
                <button class="primary" @onclick="SaveAccountAsync"
                        disabled="@(_busy.IsRunning || string.IsNullOrWhiteSpace(_aniListAccount))">
                    Save
                </button>
            </div>

            @if (_accountError is not null)
            {
                <div class="notice error" role="alert">@_accountError</div>
            }
        }
        else if (!status.CanFetch)
        {
            @* A source AniQueue cannot go and read, so the user brings it. It sits
               here rather than on a page of its own because it is a source in every
               sense that matters — it names titles, it ranks against the other, and
               its export is how most libraries arrive (D30). What made it look like
               something else was only that it has no account to configure. *@
            <p class="muted">
                Upload an export. In MyAnimeList, go to <strong>List → Export</strong> and
                download the anime list; the file arrives gzipped, so extract it until it
                ends in <code>.xml</code>. Nothing is saved until you review the preview.
            </p>

            <InputFile id="import-file" class="file-input" OnChange="OnFileSelectedAsync"
                       accept=".xml" disabled="@_busy.IsRunning"
                       aria-label="Select MyAnimeList export file" />
        }
        else
        {
            <p class="muted">
                Reading the public list of <strong>@status.Account</strong> &middot;
                @LastRunText(status.LastSuccess) &middot; @ScheduleText(status.Settings.Schedule)
            </p>

            <div class="toolbar">
                <button class="primary" disabled="@(_busy.IsRunning || !CanSync(status))"
                        @onclick="() => SyncAsync(status)">
                    Sync now
                </button>
            </div>
        }

        @* Everything below describes the source's standing state rather than the
           preview below it — how long ago it last ran, what it has stopped listing,
           how much of the relation graph is known — so none of it is an answer to
           the question a preview asked. It comes back on Discard. *@
        @if (status.IsConfigured && !IsPreviewing)
        {
            @* Failure and success are stated separately, and both survive: "last
               synced 3 hours ago, last attempt failed because the profile is
               private" is actionable where either half alone is not. The failure
               stays until a later run reaches the source, because a sync that
               stopped working must never read as up to date (§4). *@
            @if (status.LastFailure is { FailureReason: { } reason } failure
                 && (status.LastSuccess is null || failure.Id > status.LastSuccess.Id))
            {
                <div class="notice @(status.IsStalled ? "error" : "warning")" role="status">
                    Last attempt @Ago(failure.StartedAt) failed: @reason
                    @if (status.IsStalled)
                    {
                        <text>
                            This is the @status.ConsecutiveFailures<sup>th</sup> failure in a row, so
                            what you are looking at is as old as the last success above.
                        </text>
                    }
                </div>
            }

            @if (status.LastRun is { Outcome: SyncOutcome.HeldForReview, ChangesHeld: > 0 } waiting)
            {
                @* The point of recording a held run at all. Without this the page
                   would say "checked 20 minutes ago, nothing to change" about a run
                   that found a dozen changes and was told not to apply them. *@
                <div class="notice info" role="status">
                    A scheduled run found @waiting.ChangesHeld
                    @(waiting.ChangesHeld == 1 ? "change" : "changes") and did not apply
                    @(waiting.ChangesHeld == 1 ? "it" : "them"), because this source is set to
                    ask first. Sync now to look at @(waiting.ChangesHeld == 1 ? "it" : "them").
                </div>
            }

            @if (status.LastRun is { ConflictsHeld: > 0 } held)
            {
                <div class="notice info" role="status">
                    @held.ConflictsHeld @(held.ConflictsHeld == 1 ? "conflict was" : "conflicts were")
                    left undecided. Syncing again brings them back — nothing about them has changed.
                </div>
            }

            @if (status.AbsentCount > 0)
            {
                @* Named rather than counted, because "3 titles were removed" sends
                   the user hunting through several hundred rows to find out which. *@
                <div class="notice warning" role="status">
                    @status.AbsentCount @(status.AbsentCount == 1 ? "title is" : "titles are")
                    no longer on @status.Source: @string.Join(", ", status.AbsentTitles)@(status.AbsentCount > status.AbsentTitles.Count ? $" and {status.AbsentCount - status.AbsentTitles.Count} more" : "").
                    @(status.AbsentCount == 1 ? "It is" : "They are") still in your library and
                    still queueable — AniQueue does not delete anything a source stops listing.
                </div>
            }

            @* One line, and only while there is something outstanding. Enrichment
               degrades silently (D25): a backfill still working through a library is
               not a problem, and a page that announced it would be announcing the
               application doing its job. What it does answer is the question a user
               with a new library actually asks — why some rows have no related
               titles yet. *@
            @if (status.Source == AnimeSource.AniList && _relations is { Total: > 0 } coverage)
            {
                <div class="toolbar">
                    @* Stated before it is pressed, because "refresh" is otherwise a
                       button with no visible effect: relations rarely change, so the
                       honest outcome of most presses is that nothing happens. *@
                    <span class="muted">
                        @if (coverage.IsComplete)
                        {
                            <text>
                                Related titles known for all @coverage.Total titles, and re-read
                                every 30 days. Refresh if you know something has changed.
                            </text>
                        }
                        else
                        {
                            <text>
                                Related titles known for @coverage.Known of @coverage.Total titles.
                                The rest fill in on their own.
                            </text>
                        }
                    </span>

                    <button disabled="@(_busy.IsRunning || !CanSync(status))"
                            @onclick="RefreshRelationsAsync">
                        Refresh related titles
                    </button>
                </div>

                @if (_refreshed is { } refreshed)
                {
                    <div class="notice success" role="status">@RefreshText(refreshed)</div>
                }
            }
        }

        @* Inside the guard, not after it. It was left outside when the rest of the
           card learned to collapse, so a preview shrank everything except the one
           section tall enough to matter — settings are the least urgent thing on
           this page and were the only thing that stayed. *@
        @if (!IsPreviewing)
        {
        <details class="source-settings">
            <summary>Settings</summary>

            @* Configured, not merely fetchable. An unconfigured source already offers
               this field in the card above, where it is the one thing to do, and
               drawing it here as well would be two controls over one setting — which
               is the bug D30's single primary seat was written against, reappearing on
               a text box. Once an account exists the card shows what it is reading and
               this is where changing it belongs. *@
            @if (status.CanFetch && status.IsConfigured)
            {
                @* The one control on this page that writes to userconfig.json rather
                   than to the database (D36), and deliberately indistinguishable from
                   the ones that do: which store holds a value is AniQueue's problem,
                   not the reader's. *@
                <div class="field">
                    <label for="anilist-account-settings">AniList username</label>
                    <input id="anilist-account-settings" type="text" maxlength="60" spellcheck="false"
                           disabled="@_busy.IsRunning"
                           @bind="_aniListAccount" @bind:event="oninput"
                           @onkeydown="OnAccountKeyDownAsync" />
                    <p class="muted">
                        The list must be public. Saved to <code>@Settings.Path</code>, which is
                        where to change it by hand if this page is ever unreachable.
                    </p>

                    <div class="toolbar">
                        <button @onclick="SaveAccountAsync"
                                disabled="@(_busy.IsRunning || _aniListAccount == status.Account)">
                            Save username
                        </button>
                    </div>

                    @if (_accountError is not null)
                    {
                        <div class="notice error" role="alert">@_accountError</div>
                    }
                </div>
            }

            @if (status.CanFetch)
            {
                <div class="field">
                    <label for="@($"enabled-{status.Source}")">
                        <input type="checkbox" id="@($"enabled-{status.Source}")"
                               checked="@status.Settings.IsEnabled"
                               @onchange="e => Update(status, s => s with { IsEnabled = (bool)(e.Value ?? false) })" />
                        Sync this source
                    </label>
                </div>
            }

            @* A radio rather than a per-source dropdown, and the difference is the
               point (D30). Primary is a single seat: two dropdowns could both say
               "Primary", and two primaries tie — which D29 settles by letting the
               last import win, the behaviour the setting exists to end. A radio
               cannot express that state, and choosing one here demotes the other
               without the user having to go and do it.

               Sharing a name across cards is what makes the browser enforce it, so
               the two are one group even though they are drawn in two places. *@
            <div class="field">
                <label for="@($"primary-{status.Source}")">
                    <input type="radio" id="@($"primary-{status.Source}")"
                           name="primary-source"
                           checked="@status.IsPrimary"
                           @onchange="() => SetPrimaryAsync(status)" />
                    Treat @status.Source as primary
                </label>
                <p class="muted">
                    The primary source decides status, progress and score, and settles any
                    disagreement about a title's name or type. Only consulted where two sources
                    both know a title — with one source it never applies. A secondary source
                    still fills in what the primary has no answer for, because a gap is not a
                    disagreement.
                </p>
            </div>

            @* Scheduling, conflicts and absence are all things a run does, and nothing
               runs on a file source — you bring the file. Gated rather than disabled,
               because a disabled control still says "this could apply to me". *@
            @if (status.CanFetch)
            {
            <fieldset>
                <legend>When syncing runs on its own</legend>
                <p class="muted">
                    AniQueue can read this source on a schedule, with nobody watching.
                    It is off until you turn it on, and these decide what a run may do.
                </p>

                <div class="field">
                    <label for="@($"schedule-{status.Source}")">Check this source</label>
                    <select id="@($"schedule-{status.Source}")" value="@status.Settings.Schedule"
                            @onchange="e => Update(status, s => s with { Schedule = Parse(e.Value, s.Schedule) })">
                        <option value="@SyncSchedule.Off">Only when I press Sync now</option>
                        <option value="@SyncSchedule.Hourly">Every hour</option>
                        <option value="@SyncSchedule.EverySixHours">Every six hours</option>
                        <option value="@SyncSchedule.Daily">Once a day</option>
                        <option value="@SyncSchedule.Weekly">Once a week</option>
                    </select>
                    <p class="muted">
                        A scheduled run is the same read as Sync now — nothing is ever written
                        back to your account. Times are approximate, and a run that keeps failing
                        is retried progressively less often rather than every hour forever.
                    </p>
                </div>

                <div class="field">
                    <label for="@($"unattended-{status.Source}")">
                        <input type="checkbox" id="@($"unattended-{status.Source}")"
                               checked="@status.Settings.ApplyUnattended"
                               @onchange="e => Update(status, s => s with { ApplyUnattended = (bool)(e.Value ?? false) })" />
                        Apply changes without asking
                    </label>
                    <p class="muted">
                        Only the unambiguous ones. Anything AniQueue cannot confidently
                        identify is held for you either way.
                    </p>
                </div>

                <div class="field">
                    <label for="@($"conflicts-{status.Source}")">Conflicts</label>
                    <select id="@($"conflicts-{status.Source}")" value="@status.Settings.ConflictPolicy"
                            @onchange="e => Update(status, s => s with { ConflictPolicy = Parse(e.Value, s.ConflictPolicy) })">
                        <option value="@SyncConflictPolicy.HoldForReview">Hold for me to decide</option>
                        <option value="@SyncConflictPolicy.LinkToExisting">Link when the titles match exactly</option>
                    </select>
                    <p class="muted">
                        Linking automatically is opting into merging by title. The test is exact,
                        letter for letter, and an ambiguous match is still held.
                    </p>
                </div>

                <div class="field">
                    <label for="@($"absence-{status.Source}")">Titles removed from the source</label>
                    <select id="@($"absence-{status.Source}")" value="@status.Settings.AbsencePolicy"
                            @onchange="e => Update(status, s => s with { AbsencePolicy = Parse(e.Value, s.AbsencePolicy) })">
                        <option value="@SyncAbsencePolicy.Flag">Flag them for me</option>
                        <option value="@SyncAbsencePolicy.Ignore">Leave them alone</option>
                    </select>
                    <p class="muted">
                        Only titles this source has listed before are ever in scope. Anything
                        it has never known about — imported from a file, or added by hand — is
                        never touched, whatever this says.
                    </p>
                    @* "Remove them here too" is a stored value with no option to select
                       it, deliberately. A truncated response, a paging bug, a mistyped
                       account and a profile turned private all look identical to "the
                       user deleted everything", and an emptied library taking the
                       hand-built queue with it is the one failure here with no recovery
                       path in the product (D19).

                       This used to promise an in-application backup as the thing that
                       would make it survivable. D33 declined that — the recovery path is
                       the database file itself — so what it now waits on is the guards
                       D19 lists, and the copy is the operator's to keep. Saying so is
                       more useful than a promise: it tells the one person who can make
                       the removal survivable what to actually do. *@
                    <p class="muted">
                        Deleting them here as well is not offered yet: an unlucky sync would
                        have nothing inside AniQueue to undo it. Your library lives in a single
                        database file, so a copy of it is the way back from one.
                    </p>
                </div>
            </fieldset>
            }
        </details>
        }
    </div>
}

@* Lifted out of the per-source settings, where it had been sitting inside AniList's
   card. It is a profile preference rather than a fact about a source — it decides
   how every title is displayed, whichever list it came from — and with a second
   card on the page it would otherwise have been drawn twice, as two controls over
   one setting (D30). Hidden while a preview is up, like everything else that is not
   an answer to it. *@
@if (!IsPreviewing && _applied is null)
{
    <div class="card">
        <div class="field">
            <label for="title-language">Show titles in</label>
            <select id="title-language" value="@_titleLanguage" @onchange="OnTitleLanguageChangedAsync">
                <option value="@TitleLanguage.Romaji">Romaji — Shingeki no Kyojin</option>
                <option value="@TitleLanguage.English">English — Attack on Titan</option>
                <option value="@TitleLanguage.Native">Native — 進撃の巨人</option>
            </select>
            <p class="muted">
                Applies immediately, to titles a source has told AniQueue about in more than
                one language. Titles that came from a file import or were added by hand have
                only one name and keep it. Where a preferred language is missing — English is,
                for roughly one title in seven — the closest one is shown instead.
            </p>
        </div>
    </div>
}

@if (_applied is { } applied)
{
    <div class="notice success" role="status">@SummaryText(applied)</div>

    @if (AdvancementText(applied.Commit) is { } advancement)
    {
        <div class="notice info" role="status">
            @advancement
            <a href="up-next">See what is next</a>.
        </div>
    }

    <div class="toolbar">
        <a class="button primary" href="backlog">View backlog</a>
        <button @onclick="Reset">Done</button>
    </div>
}

@if (PendingPreview is { } preview)
{
    <ImportPreviewView Preview="preview" IsEditable="@(_applied is null)">
        <Actions>
            <div class="card">
                @* Before and after are two different statements. Until it is applied
                   this describes something that has not happened; afterwards the same
                   tables are the record of something that has, and "nothing has been
                   saved" sitting under a green "Added 745" is a straight contradiction. *@
                @if (_applied is null)
                {
                    <h2>@(_fetch is null ? "In this file" : "What syncing would change")</h2>
                    <p class="muted">
                        Nothing has been saved. @preview.CompletedCount completed &middot;
                        @preview.WatchingCount watching &middot; @preview.PlanningCount planning
                    </p>

                    <div class="toolbar">
                        <button class="primary" disabled="@(_busy.IsRunning || !preview.HasApplicableChanges)"
                                @onclick="ApplyAsync">
                            @ApplyButtonText(preview)
                        </button>
                        <button @onclick="Reset" disabled="@_busy.IsRunning">Cancel</button>
                    </div>
                }
                else
                {
                    <h2>@(_fetch is null ? "What the import changed" : "What the sync changed")</h2>
                    <p class="muted">
                        Saved to your library. @preview.CompletedCount completed &middot;
                        @preview.WatchingCount watching &middot; @preview.PlanningCount planning
                    </p>
                }
            </div>
        </Actions>
    </ImportPreviewView>
}

@* Blocking rather than a disabled button: a real list takes seconds to fetch and
   compare, during which the page would otherwise look frozen. *@
<BusyDialog State="_busy" />

@code {
    // Resolved by key: the file this page accepts is MyAnimeList XML specifically,
    // and asking for a bare IAnimeListParser would silently start resolving
    // whichever parser was registered last once a second one exists.
    [Inject(Key = AnimeSource.MyAnimeList)]
    private IAnimeListParser Parser { get; set; } = null!;

    private IReadOnlyList<SourceSyncStatus> _statuses = [];

    // Two ways in, one review surface. A fetch is kept whole because applying one
    // needs the absence count and the source it came from; a file has nothing to
    // remember beyond the preview itself. Which of the two is set is also what
    // decides how the preview gets committed (D30).
    private SyncFetchResult? _fetch;
    private ImportPreview? _filePreview;

    // Which source the pending preview belongs to. Set alongside it rather than
    // derived, so the file path does not have to assert which parser it used in
    // every place that asks.
    private AnimeSource? _pendingSource;

    private SyncApplyResult? _applied;
    private TitleLanguage _titleLanguage;
    private RelationCoverage? _relations;
    private RelationBackfillResult? _refreshed;
    private bool _nothingToDo;
    private string? _error;

    /// <summary>
    /// Whether a preview — or the report of one that was applied — is what the page
    /// is currently about.
    /// </summary>
    /// <remarks>
    /// It stays true after applying, because the report has the same problem the
    /// preview did: it is the thing the user pressed a button to see, and the source
    /// cards would push it just as far down the page.
    /// </remarks>
    private ImportPreview? PendingPreview => _fetch?.Preview ?? _filePreview;

    private bool IsPreviewing => PendingPreview is not null;

    /// <summary>
    /// Which source cards belong on the page right now.
    /// </summary>
    /// <remarks>
    /// <b>While a preview is up, only the source that produced it.</b> The page
    /// showed every card and let each render its own way out, so two sources meant
    /// two <i>Discard this preview</i> buttons for one preview — and the second one
    /// belonged to a source that had nothing to do with what was on screen. A
    /// preview is one source's answer, so it is one source's card.
    ///
    /// None at all once it has been applied: the report below owns that state and
    /// carries both of the things left to do — look at the backlog, or finish — so a
    /// card there would be a box with no contents and no purpose.
    /// </remarks>
    private IEnumerable<SourceSyncStatus> VisibleSources =>
        _applied is not null ? []
        : PendingSource is { } pending ? _statuses.Where(s => s.Source == pending)
        : _statuses;

    /// <summary>
    /// Which source the preview on screen came from, or null when there is none.
    /// </summary>
    /// <remarks>
    /// Recorded when the preview is made rather than inferred from what is set,
    /// because the file path has no fetch to read it off and guessing would put the
    /// assumption in every place that asks.
    /// </remarks>
    private AnimeSource? PendingSource => IsPreviewing ? _pendingSource : null;

    private BusyScope _busy = null!;
    private ToastScope _toasts = null!;

    protected override void OnInitialized()
    {
        _busy = new BusyScope(() => InvokeAsync(StateHasChanged));
        _toasts = new ToastScope(() => InvokeAsync(StateHasChanged));
    }

    public void Dispose() => _toasts.Dispose();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _statuses = await SyncService.GetStatusAsync(Profile.DefaultProfileId);
        _titleLanguage = await SyncService.GetPreferredTitleLanguageAsync(Profile.DefaultProfileId);
        _relations = await RelationBackfill.GetCoverageAsync();

        // Read every time rather than only on first load, so the field agrees with the
        // status line beside it after a save — and after a hand edit to the file that a
        // reload has since picked up.
        _aniListAccount = Settings.Read().AniListUserName ?? string.Empty;
    }

    /// <summary>The account as typed, which is not yet the account in effect.</summary>
    private string _aniListAccount = string.Empty;

    private string? _accountError;

    /// <summary>
    /// Enter saves, because a single text field with a button beside it is one the
    /// keyboard should finish.
    /// </summary>
    private async Task OnAccountKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter")
        {
            await SaveAccountAsync();
        }
    }

    private async Task SaveAccountAsync()
    {
        _accountError = null;

        var account = _aniListAccount.Trim();

        // The whole file is rewritten on every save, so everything this page is not
        // editing has to be read back and passed through — otherwise saving a username
        // would quietly clear the scoring sizes the Recommendations page wrote.
        var result = await Settings.SaveAsync(Settings.Read() with
        {
            AniListUserName = account.Length == 0 ? null : account
        });

        if (!result.Saved)
        {
            _accountError = $"Could not save to {result.Path}: {result.Error}";
            return;
        }

        await _toasts.ShowAsync("Username saved");

        // Reloaded rather than assumed: the status carries whether the source is
        // configured and what it is reading, and both have just changed. Sync now has
        // to appear without the page being refreshed by hand, which is the only visible
        // sign that the save took effect.
        await LoadAsync();
    }

    private bool CanSync(SourceSyncStatus status) =>
        SyncConfiguration.CurrentValue.Enabled && status.IsConfigured && status.Settings.IsEnabled;

    private async Task SyncAsync(SourceSyncStatus status)
    {
        Reset();

        var fetch = await _busy.RunAsync(
            $"Syncing with {status.Source}",
            progress => SyncService.FetchAsync(Profile.DefaultProfileId, status.Source, progress));

        if (!fetch.Succeeded)
        {
            _error = fetch.FailureReason;
        }
        else if (fetch.IsComplete)
        {
            // Already over: the list matched what is here, and the run has been
            // recorded as such. Showing empty tables would suggest otherwise.
            _nothingToDo = true;
        }
        else
        {
            _fetch = fetch;
            _pendingSource = fetch.Source;
        }

        await LoadAsync();
    }

    /// <summary>
    /// Commits whichever preview is on screen.
    /// </summary>
    /// <remarks>
    /// The two differ only in what records the attempt. A sync writes a
    /// <c>SyncRun</c> — it is a scheduled thing that can fail unattended, and the
    /// page has to be able to say when it last worked — while a file import has no
    /// history worth keeping, because the file was here and the user watched it
    /// happen. Everything after that is the same commit through the same pipeline
    /// (D30), which is why the result type is shared.
    /// </remarks>
    private async Task ApplyAsync()
    {
        if (PendingPreview is not { } preview)
        {
            return;
        }

        var fetch = _fetch;
        var count = preview.CreateCount + preview.UpdateCount + preview.ResolvedConflictCount;

        try
        {
            _applied = await _busy.RunAsync(
                $"Applying {count} {(count == 1 ? "change" : "changes")}",
                async progress => fetch is not null
                    ? await SyncService.ApplyAsync(fetch, Profile.DefaultProfileId, progress)
                    : new SyncApplyResult
                    {
                        Commit = await ImportService.CommitAsync(
                            preview, Profile.DefaultProfileId, progress),

                        // A file's conflicts are resolved in the same preview and
                        // counted the same way; there is simply no run row to put
                        // them in.
                        ConflictsHeld = preview.Items.Count(i =>
                            i.Action == ImportAction.Conflict && i.Resolution == ConflictResolution.Skip)
                    });

            // Said out loud, as the unattended job says it. Two audiences hear it and
            // both were being left out: any other page open on this library learns it
            // has gone stale, and the enrichment jobs get a tick now rather than at
            // the next quarter hour — which is what stops "refresh related titles"
            // being the only way to fill in several hundred new titles (D25).
            Changes.Publish(new LibraryChange
            {
                Source = _pendingSource ?? AnimeSource.MyAnimeList,
                Created = _applied.Commit.Created,
                Updated = _applied.Commit.Updated,
                SlotsReleased = _applied.Commit.QueueSlotsReleased,
                AbsentFlagged = fetch?.AbsentFlagged ?? 0
            });
        }
        catch (Exception ex)
        {
            // The transaction has already rolled back; what the user needs to know
            // is that the library is unchanged rather than half written.
            Logger.LogError(ex, "Sync apply failed");
            _error = "The sync could not be applied. Your library has not been changed.";
        }

        await LoadAsync();
    }

    /// <summary>
    /// Writes one settings change immediately rather than behind a save button.
    /// </summary>
    /// <remarks>
    /// There is no draft state worth protecting here — each control is one
    /// independent decision, and a save button on a page whose main action is a
    /// different button is an easy thing to leave unpressed.
    /// </remarks>
    /// <summary>
    /// Applies one change to a source's settings and writes them.
    /// </summary>
    /// <remarks>
    /// Takes a function rather than an action because <c>SourceSyncSettings</c> stopped
    /// being a mutable entity in Phase 10a — the settings are a value read from
    /// <c>userconfig.json</c>, so a change produces a new one rather than editing the
    /// instance the page happens to be holding.
    /// </remarks>
    private async Task Update(
        SourceSyncStatus status,
        Func<SourceSyncSettings, SourceSyncSettings> change)
    {
        _error = null;

        var result = await SyncService.SaveSettingsAsync(change(status.Settings));

        // Reported rather than swallowed, because since Phase 10a this writes a file
        // and §9's non-root container writing to a root-owned bind mount cannot. A
        // checkbox left showing a value nothing kept is the worst of the three
        // outcomes available here.
        if (!result.Saved)
        {
            _error = $"Could not save to {result.Path}: {result.Error}";
            await LoadAsync();
            return;
        }

        await LoadAsync();

        // These are the controls that most needed saying so: they save the moment they
        // are changed, with no button to go quiet afterwards, so until now a checkbox
        // that worked and a checkbox that did nothing looked identical.
        await _toasts.ShowAsync("Saved");
    }

    private async Task OnTitleLanguageChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<TitleLanguage>(e.Value?.ToString(), out var language))
        {
            return;
        }

        _titleLanguage = language;
        await SyncService.SavePreferredTitleLanguageAsync(Profile.DefaultProfileId, language);

        await _toasts.ShowAsync("Saved");
    }

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;

    private static TEnum Parse<TEnum>(object? value, TEnum fallback) where TEnum : struct, Enum =>
        Enum.TryParse<TEnum>(value?.ToString(), out var parsed) ? parsed : fallback;

    /// <summary>
    /// Says when the source was last actually read, and what that read found.
    /// </summary>
    /// <remarks>
    /// Takes the last <em>success</em> rather than the last run, and the failure is
    /// reported beside it instead of replacing it. A single line that flips to "last
    /// attempt failed" the moment anything goes wrong loses the fact a user most
    /// needs while it is going wrong: how old the data they are looking at actually
    /// is (§4).
    /// </remarks>
    private static string LastRunText(SyncRun? run) => run switch
    {
        null => "never synced",
        { Outcome: SyncOutcome.NothingToDo } => $"checked {Ago(run.StartedAt)}, nothing to change",
        { Outcome: SyncOutcome.HeldForReview } => $"checked {Ago(run.StartedAt)}, changes waiting",
        _ => $"synced {Ago(run.StartedAt)}"
    };

    private static string ScheduleText(SyncSchedule schedule) => schedule switch
    {
        SyncSchedule.Hourly => "checking every hour",
        SyncSchedule.EverySixHours => "checking every six hours",
        SyncSchedule.Daily => "checking once a day",
        SyncSchedule.Weekly => "checking once a week",
        _ => "only when you ask"
    };

    private static string Ago(DateTimeOffset moment)
    {
        var elapsed = DateTimeOffset.UtcNow - moment;

        return elapsed switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)elapsed.TotalMinutes} min ago",
            { TotalHours: < 24 } => $"{(int)elapsed.TotalHours} h ago",
            _ => $"{(int)elapsed.TotalDays} d ago"
        };
    }

    private static string ApplyButtonText(ImportPreview preview)
    {
        if (!preview.HasApplicableChanges)
        {
            return "Nothing to apply";
        }

        var total = preview.CreateCount + preview.UpdateCount + preview.ResolvedConflictCount;
        return $"Apply {total} {(total == 1 ? "change" : "changes")}";
    }

    private static string SummaryText(SyncApplyResult result)
    {
        var text = $"Added {result.Commit.Created} and updated {result.Commit.Updated}";
        return result.ConflictsHeld > 0
            ? $"{text}, leaving {result.ConflictsHeld} for you to decide later."
            : $"{text}.";
    }

    /// <summary>Explains a queue that just got shorter (D12).</summary>
    private static string? AdvancementText(ImportCommitResult result) =>
        result.QueueSlotsReleased switch
        {
            0 => null,
            1 => "One title left Up Next because you have started or finished it.",
            var n => $"{n} titles left Up Next because you have started or finished them."
        };

    /// <summary>
    /// Reads an export and previews it, without writing anything.
    /// </summary>
    /// <remarks>
    /// The same review surface a sync gets, because the difference between the two
    /// is the trigger rather than the logic (§5). What is specific to a file is only
    /// getting the bytes: the default <c>OpenReadStream</c> cap is 512 KB, far below
    /// a real export, and the parser enforces the same ceiling again on what it
    /// reads so the limit holds whichever way in was used.
    /// </remarks>
    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        Reset();

        try
        {
            _filePreview = await _busy.RunAsync($"Reading {e.File.Name}", async progress =>
            {
                await using var stream = e.File.OpenReadStream(ImportLimits.Default.MaxBytes);

                return await ImportService.PreviewAsync(
                    stream, Parser, Profile.DefaultProfileId, progress);
            });

            _pendingSource = AnimeSource.MyAnimeList;

            if (_filePreview.IsFileRejected)
            {
                _error = string.Join(" ", _filePreview.Problems.Select(p => p.Message));

                // A rejected file has nothing to review, so it must not leave the page
                // in the previewing state — the cards would collapse around an empty
                // surface and the only way out would be Discard.
                _filePreview = null;
            }
        }
        catch (IOException ex)
        {
            // Thrown when the upload exceeds the stream limit.
            Logger.LogWarning(ex, "Import upload rejected");
            _error = "That file is too large to import.";
        }
    }

    /// <summary>
    /// Promotes one source, which is the only way to change who is primary (D30).
    /// </summary>
    /// <remarks>
    /// There is no matching demote. The seat is single, so taking it away from the
    /// only holder would leave nobody in it — and the radio cannot express that,
    /// which is why it is a radio.
    /// </remarks>
    private async Task SetPrimaryAsync(SourceSyncStatus status)
    {
        _error = null;

        var result = await SyncService.SetPrimarySourceAsync(Profile.DefaultProfileId, status.Source);

        if (!result.Saved)
        {
            _error = $"Could not save to {result.Path}: {result.Error}";
        }

        await LoadAsync();
    }

    private void Reset()
    {
        _fetch = null;
        _filePreview = null;
        _pendingSource = null;
        _applied = null;
        _nothingToDo = false;
        _error = null;
        _refreshed = null;
    }

    /// <summary>
    /// Forgets every answer and asks again, now.
    /// </summary>
    /// <remarks>
    /// The only user-triggered path into any of the relation machinery. It exists
    /// because the automatic answer is deliberately slow — thirty days — and
    /// somebody who has just seen a sequel announced should not have to wait that
    /// long for the application to notice.
    ///
    /// A full pass is roughly fifteen requests spread two seconds apart, so this is
    /// half a minute of waiting. Run behind the busy dialog with a count rather than
    /// in the background, because a button whose effect is invisible for half a
    /// minute reads as a button that did not work.
    /// </remarks>
    private async Task RefreshRelationsAsync()
    {
        Reset();

        _refreshed = await _busy.RunAsync(
            "Reading related titles",
            progress => RelationBackfill.RefreshAsync(RefreshRequestCeiling, progress));

        _relations = await RelationBackfill.GetCoverageAsync();
    }

    /// <summary>
    /// Enough requests for a library several times the size of a realistic one, so
    /// the button normally finishes what it started.
    /// </summary>
    /// <remarks>
    /// Higher than the background job's ceiling on purpose: that one is spending a
    /// tick it shares with nothing, while this one has somebody watching a dialog
    /// and expecting it to be over when the dialog closes.
    /// </remarks>
    private const int RefreshRequestCeiling = 60;

    private static string RefreshText(RelationBackfillResult result) => result switch
    {
        { FailureReason: { } reason } => $"Stopped after {result.Requested} titles: {reason}",

        // The common outcome, and worth saying plainly rather than leaving the page
        // looking as though nothing happened. Relations change rarely; that is the
        // feature working, not the button failing.
        { ChangedAnything: false } => $"Re-read {result.Requested} titles. Nothing had changed.",

        { EdgesRemoved: 0 } => $"Re-read {result.Requested} titles and found {result.EdgesWritten} new "
            + $"{(result.EdgesWritten == 1 ? "relation" : "relations")}.",

        { EdgesWritten: 0 } => $"Re-read {result.Requested} titles. {result.EdgesRemoved} "
            + $"{(result.EdgesRemoved == 1 ? "relation is" : "relations are")} no longer published and "
            + $"{(result.EdgesRemoved == 1 ? "was" : "were")} removed.",

        _ => $"Re-read {result.Requested} titles: {result.EdgesWritten} new, "
            + $"{result.EdgesRemoved} no longer published."
    };
}
