@page "/import"
@inject IImportService ImportService
@inject ILogger<Import> Logger

<PageTitle>Import — AniQueue</PageTitle>

<div class="page-header">
    <h1>Import</h1>
    <p>
        Upload a MyAnimeList XML export. Nothing is saved until you review the
        preview and confirm.
    </p>
</div>

@if (_error is not null)
{
    <div class="notice error" role="alert">@_error</div>
}

@* The outcome and what to do next sit above the detail rather than below it. A
   finished import leaves several screens of preview tables on the page, and the
   result is what the user came back for — it should not require scrolling past
   the thing it describes. *@
@if (_commitResult is { } result)
{
    <div class="notice success" role="status">@SummaryText(result)</div>

    @if (AdvancementText(result) is { } advancement)
    {
        <div class="notice info" role="status">
            @advancement
            <a href="up-next">See what is next</a>.
        </div>
    }

    <div class="toolbar">
        <a class="button primary" href="backlog">View backlog</a>
        <button @onclick="Reset">Import another file</button>
    </div>
}

@if (_commitResult is null)
{
    <div class="card">
        <h2>Choose a file</h2>
        <p class="muted">
            In MyAnimeList, go to List &rarr; Export and download the anime list. The
            file may be gzipped; extract it first so it ends in <code>.xml</code>.
        </p>

        @* A styled <label for> alongside the input produced two visible buttons —
           the label and the input's own native one. Styling the native control
           instead keeps a single button and keeps its built-in keyboard and
           screen-reader behaviour. *@
        <InputFile id="import-file" class="file-input" OnChange="OnFileSelectedAsync"
                   accept=".xml" disabled="@_busy.IsRunning" aria-label="Select MyAnimeList export file" />

        @* The native control renders the chosen file name itself, and reading
           status now lives in the busy dialog, so nothing is added here. *@
    </div>
}

@if (_preview is { IsFileRejected: false } preview)
{
    <div class="stat-row">
        <div class="stat"><div class="value">@preview.CreateCount</div><div class="label">New</div></div>
        <div class="stat"><div class="value">@preview.UpdateCount</div><div class="label">Updated</div></div>
        <div class="stat"><div class="value">@preview.UnchangedCount</div><div class="label">Unchanged</div></div>
        <div class="stat"><div class="value">@preview.ConflictCount</div><div class="label">Conflicts</div></div>
        <div class="stat"><div class="value">@preview.InvalidCount</div><div class="label">Invalid</div></div>
    </div>

    <div class="card">
        <h2>In this file</h2>
        <p class="muted">
            @preview.CompletedCount completed &middot; @preview.WatchingCount watching
            &middot; @preview.PlanningCount planning
        </p>

        @if (_commitResult is null)
        {
            <div class="toolbar">
                <button class="primary" disabled="@(_busy.IsRunning || !preview.HasApplicableChanges)"
                        @onclick="CommitAsync">
                    @ImportButtonText(preview)
                </button>
                <button @onclick="Reset" disabled="@_busy.IsRunning">Cancel</button>
            </div>

            @if (!preview.HasApplicableChanges && preview.UnchangedCount > 0)
            {
                <div class="notice info">
                    Everything in this file already matches your library, so importing
                    would change nothing.
                </div>
            }
        }
    </div>

    @if (preview.ConflictCount > 0)
    {
        @* Tinted because this is the only section that needs a decision; everything
           else on the page is a report. *@
        <div class="card needs-decision">
            <h2>Conflicts — @preview.ConflictCount needing a decision</h2>
            <p class="muted">
                AniQueue will not merge entries it cannot confidently identify, because an
                incorrect merge is much harder to undo than a skipped row. You know whether
                these are the same title, so the choice is yours. Skipping changes nothing.
            </p>

            @if (_commitResult is null)
            {
                <div class="toolbar">
                    <span class="muted">Set all to:</span>
                    <button class="choice skip" @onclick="() => SetAllConflicts(ConflictResolution.Skip)">Skip</button>
                    <button class="choice link" @onclick="() => SetAllConflicts(ConflictResolution.LinkToExisting)">Link to existing</button>
                    <button class="choice new" @onclick="() => SetAllConflicts(ConflictResolution.ImportAsNew)">Import as new</button>
                </div>

                @* Says what confirming will actually do, so the decision does not have
                   to be reconstructed by reading down the Action column. *@
                <p class="muted">
                    <strong>@ConflictPlanText(preview)</strong>
                </p>
            }

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Incoming title</th>
                            <th>Already in library</th>
                            <th>Why</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in preview.Items.Where(i => i.Action == ImportAction.Conflict))
                        {
                            <tr>
                                <td>@item.Entry.Title</td>
                                <td class="muted">@(item.ExistingTitle ?? "—")</td>
                                <td class="muted">@item.ConflictReason</td>
                                <td>
                                    @if (_commitResult is null)
                                    {
                                        @* Coloured by what the choice does, using the same
                                           language as the action badges: green adds, amber
                                           modifies something that already exists, neutral
                                           changes nothing. Amber on "link" is deliberate —
                                           it rewrites an existing record and is the hardest
                                           of the three to undo. *@
                                        <select class="resolution @ResolutionClass(item.Resolution)"
                                                value="@item.Resolution"
                                                @onchange="e => SetResolution(item, e)"
                                                aria-label="@($"How to handle {item.Entry.Title}")">
                                            <option value="@ConflictResolution.Skip">Skip — no change</option>
                                            @if (item.ExistingAnimeId is not null)
                                            {
                                                <option value="@ConflictResolution.LinkToExisting">Link to existing — rewrites it</option>
                                            }
                                            <option value="@ConflictResolution.ImportAsNew">Import as new — adds a copy</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span class="badge @ResolutionClass(item.Resolution)">@item.Resolution</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="muted">
                <strong>Link to existing</strong> treats them as the same title: the existing
                entry adopts the MyAnimeList identifier and progress, so it will match cleanly
                on every future import. <strong>Import as new</strong> adds a separate entry.
            </p>
        </div>
    }

    @if (preview.Problems.Count > 0)
    {
        <div class="card">
            <h2>Problems</h2>
            <ul class="muted">
                @foreach (var problem in preview.Problems.Take(50))
                {
                    <li>@problem.ToString()</li>
                }
            </ul>
            @if (preview.Problems.Count > 50)
            {
                <p class="muted">…and @(preview.Problems.Count - 50) more.</p>
            }
        </div>
    }

    <div class="card">
        @{
            var changing = preview.Items
                .Where(i => i.Action is ImportAction.Create or ImportAction.Update)
                .ToList();
            var totalPages = Math.Max(1, (changing.Count + PageSize - 1) / PageSize);
            _changesPage = Math.Clamp(_changesPage, 0, totalPages - 1);
            var visible = changing.Skip(_changesPage * PageSize).Take(PageSize).ToList();
        }

        <h2>Changes — @changing.Count</h2>

        @if (changing.Count == 0)
        {
            <p class="empty-state">No entries would be created or updated.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Action</th><th>Title</th><th>Status</th>
                            <th class="numeric">Score</th><th>Changes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in visible)
                        {
                            <tr>
                                <td><span class="badge @item.Action.ToString().ToLowerInvariant()">@item.Action</span></td>
                                <td>@item.Entry.Title</td>
                                <td>@item.Entry.Status</td>
                                <td class="numeric">@(item.Entry.UserScore?.ToString() ?? "—")</td>
                                <td class="muted">@string.Join("; ", item.Changes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Paged rather than truncated. A real export runs to several hundred
               entries, and "showing the first 200" leaves the rest unreviewable
               before confirming a change to the whole library. *@
            @if (totalPages > 1)
            {
                <div class="toolbar">
                    <button @onclick="() => _changesPage = 0" disabled="@(_changesPage == 0)">First</button>
                    <button @onclick="() => _changesPage--" disabled="@(_changesPage == 0)">Previous</button>
                    <span class="muted">
                        @(_changesPage * PageSize + 1)–@Math.Min((_changesPage + 1) * PageSize, changing.Count)
                        of @changing.Count
                    </span>
                    <button @onclick="() => _changesPage++" disabled="@(_changesPage >= totalPages - 1)">Next</button>
                    <button @onclick="() => _changesPage = totalPages - 1" disabled="@(_changesPage >= totalPages - 1)">Last</button>
                </div>
            }
        }
    </div>
}

@* Blocking rather than a disabled button: a real export takes seconds, during
   which the page would otherwise look frozen and invite a second click. *@
<BusyDialog State="_busy" />

@code {
    private const int PageSize = 100;

    // Resolved by key: this page uploads MyAnimeList XML specifically, and asking
    // for a bare IAnimeListParser would silently start resolving whichever parser
    // was registered last once a second one exists.
    [Inject(Key = AnimeSource.MyAnimeList)]
    private IAnimeListParser Parser { get; set; } = null!;

    private ImportPreview? _preview;
    private ImportCommitResult? _commitResult;
    private string? _error;
    private int _changesPage;

    // Progress arrives off the render thread, so updates are marshalled back onto
    // it with InvokeAsync before touching component state.
    private BusyScope _busy = null!;

    protected override void OnInitialized() =>
        _busy = new BusyScope(() => InvokeAsync(StateHasChanged));


    private void SetResolution(ImportPreviewItem item, ChangeEventArgs e)
    {
        if (Enum.TryParse<ConflictResolution>(e.Value?.ToString(), out var resolution))
        {
            item.Resolution = resolution;
        }
    }

    private void SetAllConflicts(ConflictResolution resolution)
    {
        if (_preview is null)
        {
            return;
        }

        foreach (var item in _preview.Items.Where(i => i.Action == ImportAction.Conflict))
        {
            // Only offer linking where there is something to link to.
            item.Resolution = resolution == ConflictResolution.LinkToExisting && item.ExistingAnimeId is null
                ? ConflictResolution.Skip
                : resolution;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        Reset();

        try
        {
            _preview = await _busy.RunAsync($"Reading {e.File.Name}", async progress =>
            {
                // The default OpenReadStream cap is 512 KB, far below a real export.
                // The parser enforces the same ceiling again on the bytes it reads,
                // so the limit holds regardless of which entry point is used.
                await using var stream = e.File.OpenReadStream(ImportLimits.Default.MaxBytes);

                return await ImportService.PreviewAsync(
                    stream, Parser, Profile.DefaultProfileId, progress);
            });

            if (_preview.IsFileRejected)
            {
                _error = string.Join(" ", _preview.Problems.Select(p => p.Message));
            }
        }
        catch (IOException ex)
        {
            // Thrown when the upload exceeds the stream limit.
            Logger.LogWarning(ex, "Import upload rejected");
            _error = "That file is too large to import.";
        }
    }

    private async Task CommitAsync()
    {
        if (_preview is null)
        {
            return;
        }

        var count = _preview.CreateCount + _preview.UpdateCount + _preview.ResolvedConflictCount;
        var title = $"Importing {count} {(count == 1 ? "entry" : "entries")}";

        try
        {
            _commitResult = await _busy.RunAsync(title, progress =>
                ImportService.CommitAsync(_preview, Profile.DefaultProfileId, progress));
        }
        catch (Exception ex)
        {
            // The transaction has already rolled back; the user needs to know the
            // library is unchanged rather than partially written.
            Logger.LogError(ex, "Import commit failed");
            _error = "The import could not be completed. Your library has not been changed.";
        }
    }

    /// <summary>
    /// Maps a resolution onto the page's existing colour language: "new" adds and is
    /// green like Create, "link" rewrites an existing record and is amber like Update,
    /// "skip" changes nothing and stays neutral.
    /// </summary>
    private static string ResolutionClass(ConflictResolution resolution) => resolution switch
    {
        ConflictResolution.LinkToExisting => "link",
        ConflictResolution.ImportAsNew => "new",
        _ => "skip"
    };

    private static string ConflictPlanText(ImportPreview preview)
    {
        var conflicts = preview.Items.Where(i => i.Action == ImportAction.Conflict).ToList();
        var skip = conflicts.Count(i => i.Resolution == ConflictResolution.Skip);
        var link = conflicts.Count(i => i.Resolution == ConflictResolution.LinkToExisting);
        var create = conflicts.Count(i => i.Resolution == ConflictResolution.ImportAsNew);

        if (skip == conflicts.Count)
        {
            return "All conflicts will be skipped — nothing about them changes.";
        }

        var parts = new List<string>();
        if (link > 0)
        {
            parts.Add($"{link} existing {(link == 1 ? "entry" : "entries")} rewritten");
        }

        if (create > 0)
        {
            parts.Add($"{create} added as {(create == 1 ? "a copy" : "copies")}");
        }

        if (skip > 0)
        {
            parts.Add($"{skip} skipped");
        }

        return $"On import: {string.Join(", ", parts)}.";
    }

    private static string ImportButtonText(ImportPreview preview)
    {
        if (!preview.HasApplicableChanges)
        {
            return "Nothing to import";
        }

        var total = preview.CreateCount + preview.UpdateCount + preview.ResolvedConflictCount;
        return $"Import {total} {(total == 1 ? "entry" : "entries")}";
    }

    private static string SummaryText(ImportCommitResult result)
    {
        var text = $"Imported {result.Created} new and {result.Updated} updated";
        return result.Skipped > 0 ? $"{text}, skipping {result.Skipped}." : $"{text}.";
    }

    /// <summary>
    /// Explains a queue that just got shorter (D12).
    /// </summary>
    /// <remarks>
    /// Stated because it is surprising the first time. Slots leave Up Next on their
    /// own when the import shows they have been started elsewhere, and without a
    /// sentence saying so, an import that quietly shortens a hand-ordered queue
    /// reads as data loss rather than as the feature it is.
    /// </remarks>
    private static string? AdvancementText(ImportCommitResult result) =>
        result.QueueSlotsReleased switch
        {
            0 => null,
            1 => "One title left Up Next because you have started or finished it.",
            var n => $"{n} titles left Up Next because you have started or finished them."
        };

    private void Reset()
    {
        _preview = null;
        _commitResult = null;
        _error = null;
        _changesPage = 0;
    }
}
