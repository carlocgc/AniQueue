@* The application's front door: this is the page the whole thing is for, so it is
   the one you land on — and, being first, it is also where a fresh install has to
   say how to get a library in. *@
@page "/"
@using AniQueue.Core.Queue
@implements IAsyncDisposable
@inject ILibraryService LibraryService
@inject IQueueService QueueService
@inject IJSRuntime JS
@inject ILogger<UpNext> Logger

<PageTitle>Up Next — AniQueue</PageTitle>

<div class="page-header">
    <h1>Up Next</h1>
    @* The second sentence states the rule up front. A queue that shortens by itself is
       alarming if you do not know it is meant to, and the rule is easier to accept
       when it was explained before it happened rather than after. *@
    <p>
        Your watch order, top first. Titles leave on their own once your next import
        shows you have started them.
    </p>
</div>

<SyncHealthBanner />

@* The queue is the surface a background sync visibly changes — slots leave it
   without anyone pressing anything — so this page is the one where an open
   tab most needs telling that what it shows has moved on. *@
<StaleLibraryNotice OnRefresh="RefreshAsync" />

<BusyDialog State="_busy" />

@* A toast rather than a notice at the top of the page, which is where this used to
   be. The queue is a long list and removing happens partway down it, so a message
   pinned above the first row was written for somebody who had already scrolled past
   it. A toast is fixed to the corner and arrives where the eye already is. *@
<Toast State="_toasts" />

@if (Queue is null)
{
    <div class="empty-state" aria-live="polite">Loading…</div>
}
else if (Queue.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            @* An empty queue and an empty library are different states, and offering
               the backlog to somebody who has no library sends them to a second empty
               page. One destination either way: Sources owns every way in, because
               AniQueue assumes the library already exists somewhere. *@
            @if (_libraryIsEmpty)
            {
                <p>Nothing here yet. Bring your library in from wherever it already lives.</p>
                <div class="toolbar">
                    <a class="button primary" href="sources">Bring in your library</a>
                </div>
            }
            else
            {
                <p>Nothing queued yet.</p>
                <a class="button primary" href="backlog">Pick something from the backlog</a>
            }
        </div>
    </div>
}
else
{
    @* No card around the list, because the list is cards. One inside another reads
       as a panel of rows, which is the table this phase deleted wearing a border. *@
    <div class="toolbar">
        <span class="muted">@SummaryText()</span>
    </div>

    @* A list of cards, as the backlog is. SortableJS attaches to a container
       and finds its items by a handle selector, so a <ul> serves it exactly as a
       <tbody> did — the table was never what made drag work. *@
    <ul class="entry-list queue" @ref="_rows">
        @* Keyed by slot id, not by index. Blazor's differ otherwise matches
           cards by position, so a reorder makes it rewrite the contents of
           every card between the two — and it is the prerequisite for layering
           drag on top of this without the renderer and the DOM disagreeing
           about what moved. *@
        @foreach (var (item, index) in Queue.Select((item, index) => (item, index)))
        {
            <li class="entry-card" @key="item.QueueItemId">
                @* Mouse and touch only, and hidden from assistive technology on
                   purpose: the buttons at the other end of this card are the
                   keyboard and screen-reader path, and they are the required one.
                   A grip announced as a control that cannot be operated by keyboard
                   would be worse than one that is not announced at all. *@
                <span class="drag-handle" aria-hidden="true" title="Drag to reorder">
                    <Icon Name="grip-vertical" />
                </span>

                @* The position sits over the poster's corner rather than in a
                   column of its own. Position is the whole meaning of this list —
                   after a drag the number is the confirmation that the move landed
                   — and as a column it would cost 30px of every card at the width
                   where there is least. *@
                <span class="entry-art">
                    <CoverThumb Cover="item.Cover" OnActivate="() => ShowDetailAsync(item.AnimeId)" />
                    <span class="entry-position" aria-hidden="true">@(index + 1)</span>
                </span>

                <div class="entry-main">
                    <button type="button"
                            class="title-button entry-title"
                            aria-label="@($"Details for {item.Title}, number {index + 1} in Up Next")"
                            @onclick="() => ShowDetailAsync(item.AnimeId)">@item.Title</button>

                    <div class="entry-badges">
                        @if (item.Status is { } status)
                        {
                            <span class="badge @status.ToString().ToLowerInvariant()">@status</span>
                        }
                    </div>
                </div>

                @* Its own column at desktop width, absent below it. *@
                <p class="entry-facts">@FactsText(item)</p>

                @* Every reorder has a keyboard-operable button, and always will:
                   the non-drag path is a requirement rather than a fallback. They are
                   hidden below 720px, where a thumb drags the grip instead and four
                   20px arrows would be four things too small to hit. A keyboard and
                   the assistive technology that needs one are at the wider width. *@
                <div class="queue-actions" role="group"
                     aria-label="@($"Reorder {item.Title}")">
                    <button class="icon" disabled="@(index == 0)"
                            title="Move to top"
                            aria-label="@($"Move {item.Title} to the top")"
                            @onclick="() => MoveAsync(item, QueueMove.Top)"><Icon Name="chevrons-up" /></button>
                    <button class="icon" disabled="@(index == 0)"
                            title="Move up"
                            aria-label="@($"Move {item.Title} up")"
                            @onclick="() => MoveAsync(item, QueueMove.Up)"><Icon Name="chevron-up" /></button>
                    <button class="icon" disabled="@(index == Queue.Count - 1)"
                            title="Move down"
                            aria-label="@($"Move {item.Title} down")"
                            @onclick="() => MoveAsync(item, QueueMove.Down)"><Icon Name="chevron-down" /></button>
                    <button class="icon" disabled="@(index == Queue.Count - 1)"
                            title="Move to bottom"
                            aria-label="@($"Move {item.Title} to the bottom")"
                            @onclick="() => MoveAsync(item, QueueMove.Bottom)"><Icon Name="chevrons-down" /></button>
                </div>

                @* Outside the group above and always present, because removing is
                   not a reorder and is the one action a phone still needs. *@
                <button class="icon remove entry-action"
                        title="Remove from Up Next"
                        aria-label="@($"Remove {item.Title} from Up Next")"
                        @onclick="() => AskToRemoveAsync(item)"><Icon Name="x" /></button>
            </li>
        }
    </ul>
}

@* One instance for the page rather than one per row: a modal shows a single title
   at a time, so fifty dialogs in the markup would be forty-nine that can never
   open. *@
<ShowDetailDialog @ref="_detailDialog" OnChanged="RefreshAsync" />

@* The remove button sits alongside four reorder buttons, and a mis-aimed press
   costs the position this page exists to curate: putting a title back adds it to
   the end of the queue, wherever it was before. So it asks, and the sentence says
   both of those things.

   The same module the detail dialog uses. Only showModal gives a backdrop, an inert
   page, a focus trap and Escape, and only from script. *@
<dialog @ref="_confirmDialog" class="confirm-dialog" aria-labelledby="remove-dialog-title">
    @if (_pendingRemoval is { } pending)
    {
        <article>
            <h2 id="remove-dialog-title">Remove from Up Next</h2>

            <p>
                <strong>@pending.Title</strong> leaves your watch order and stays in your
                library. Putting it back adds it to the end, so its place here is what
                you lose.
            </p>

            <div class="toolbar">
                <button autofocus @onclick="CancelRemoveAsync">Keep it</button>
                <button class="danger" @onclick="ConfirmRemoveAsync">Remove</button>
            </div>
        </article>
    }
</dialog>

@code {
    private ShowDetailDialog? _detailDialog;

    /// <summary>Opens the detail dialog for one title.</summary>
    /// <remarks>
    /// The dialog loads its own data, which is also how this page shows relations at
    /// all: the dialog carries them.
    ///
    /// The queue is re-read when the dialog changes something, because it can now
    /// queue a whole set from in here — and this page is the queue.
    /// </remarks>
    private Task ShowDetailAsync(int animeId) =>
        _detailDialog is null ? Task.CompletedTask : _detailDialog.ShowAsync(animeId);
    // Not persisted across the prerender handoff, for the reason recorded on the
    // backlog page: persisted state is serialised into the page and posted back
    // when the circuit starts, and a long queue would push that past SignalR's
    // default 32KB receive limit — which fails the circuit rather than the read it
    // was avoiding.
    private IReadOnlyList<QueueListItem>? Queue { get; set; }

    // Whether this is a fresh install rather than an emptied queue. Only meaningful
    // once the queue has been read and found empty.
    private bool _libraryIsEmpty;

    private BusyScope _busy = null!;
    private ToastScope _toasts = null!;

    /// <summary>Which row the confirmation dialog is open on, or null.</summary>
    private QueueListItem? _pendingRemoval;

    private ElementReference _confirmDialog;
    private IJSObjectReference? _dialogModule;

    private ElementReference _rows;
    private DotNetObjectReference<UpNext>? _self;
    private IJSObjectReference? _module;
    private IJSObjectReference? _sortable;

    // Set once drag has failed to initialise, so the attempt is not repeated on
    // every subsequent render. Whatever stopped it — a blocked script, a browser
    // extension rewriting the page — will not have changed by the next one.
    private bool _dragUnavailable;

    private bool HasRows => Queue is { Count: > 0 };

    protected override void OnInitialized()
    {
        _busy = new BusyScope(() => InvokeAsync(StateHasChanged));
        _toasts = new ToastScope(() => InvokeAsync(StateHasChanged));
    }

    protected override Task OnInitializedAsync() => RefreshAsync();

    /// <summary>
    /// Attaches and detaches the drag behaviour as rows come and go.
    /// </summary>
    /// <remarks>
    /// Keyed off whether the table exists rather than off <c>firstRender</c>: the
    /// tbody is not rendered at all for an empty queue, so on a first visit with
    /// nothing queued there is no element to attach to, and the one that appears
    /// after the first add would otherwise never get wired up.
    ///
    /// This runs only in the interactive circuit — <c>OnAfterRenderAsync</c> does
    /// not run during prerendering, which is also when JS interop is unavailable.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HasRows && _sortable is null && !_dragUnavailable)
        {
            // Failing to set drag up must not take the page with it. Every reorder
            // drag offers is already reachable from the row's buttons, so a failure
            // here costs a convenience rather than a feature. Letting the exception
            // escape OnAfterRenderAsync would instead tear down the circuit and
            // leave the user with "An unhandled error has occurred".
            try
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./Components/Pages/UpNext.razor.js");

                _self ??= DotNetObjectReference.Create(this);

                // Resolved here rather than hard-coded in the module so the
                // vendored library is fetched through its fingerprinted URL and can
                // be cached for as long as its contents are unchanged.
                _sortable = await _module.InvokeAsync<IJSObjectReference>(
                    "attach", _rows, _self, Assets["lib/sortablejs/sortable.min.js"]);
            }
            catch (JSException ex)
            {
                _dragUnavailable = true;

                Logger.LogWarning(
                    ex,
                    "Drag reordering could not be initialised; the move buttons still work");
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended mid-render. Nothing to attach to any more.
            }
        }
        else if (!HasRows && _sortable is not null)
        {
            await DetachAsync();
        }
    }

    /// <summary>
    /// Called from <c>onEnd</c> once the browser has undone its own DOM move.
    /// </summary>
    /// <remarks>
    /// The indices describe the list the user was looking at, which the server is
    /// free to disagree with. <paramref name="oldIndex"/> is therefore resolved to
    /// a slot id against the queue as last read and rejected if it does not land on
    /// one, while the destination is clamped by the service — a drop past the end
    /// of a queue the browser thinks is longer plainly means "last".
    /// </remarks>
    [JSInvokable]
    public async Task OnDroppedAsync(int oldIndex, int newIndex)
    {
        if (Queue is not { } queue || oldIndex < 0 || oldIndex >= queue.Count)
        {
            return;
        }

        await ApplyAsync(
            "Reordering Up Next",
            () => QueueService.ReorderAsync(
                Profile.DefaultProfileId, queue[oldIndex].QueueItemId, newIndex));

        // A JS-initiated call is outside the normal event dispatch, so nothing
        // schedules a render for it. Without this the reorder is committed and
        // invisible — and the row is still sitting where onEnd put it back.
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        // A circuit that has already gone — the user closed the tab, or the
        // connection dropped — cannot be called into. That is the ordinary way this
        // page ends, so it is expected rather than an error, and the browser has
        // discarded everything being cleaned up here anyway.
        try
        {
            await DetachAsync();

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }

            if (_dialogModule is not null)
            {
                await _dialogModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _module = null;
        _dialogModule = null;
        _self?.Dispose();
        _self = null;

        _toasts.Dispose();
    }

    /// <summary>
    /// Tears the drag instance down once, whatever happens.
    /// </summary>
    /// <remarks>
    /// <b>The field is claimed before the first await, and that is the fix rather
    /// than the tidying.</b> This is reached from <c>OnAfterRenderAsync</c>, which
    /// renders again while the interop call is in flight — so a null check followed
    /// by an await let two calls through with the same instance. Sortable's
    /// <c>destroy</c> nulls its own element reference, so the second one threw
    /// <i>Cannot set properties of null</i>, and an exception escaping
    /// <c>OnAfterRenderAsync</c> ends the circuit. Removing the last row from the
    /// queue was enough to do it: the tbody stops rendering, this runs, and it ran
    /// twice.
    ///
    /// Failures are swallowed for the same reason the attach path swallows them:
    /// this is cleanup, and the worst case of losing it is listeners outliving a
    /// circuit that is ending anyway. Taking the page down to report that would be
    /// far worse than the leak.
    /// </remarks>
    private async Task DetachAsync()
    {
        var sortable = _sortable;

        if (sortable is null)
        {
            return;
        }

        _sortable = null;

        try
        {
            // Sortable registers document-level listeners, so an instance abandoned
            // when its rows disappear keeps them for the life of the circuit — which
            // under Interactive Server is the user's whole session.
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach", sortable);
            }

            await sortable.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit ended first. Nothing left to tear down on the other side.
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Drag reordering could not be torn down cleanly");
        }
    }

    /// <summary>
    /// Runs a queue edit and re-reads the result.
    /// </summary>
    /// <remarks>
    /// Through <see cref="BusyScope"/> rather than awaited inline. Most moves rewrite
    /// one or two rows and finish well inside the show delay, so nothing appears —
    /// but "move to top" from the bottom of a long queue rewrites every row, and
    /// Microsoft.Data.Sqlite is a synchronous provider, so awaiting that on the
    /// circuit's thread would freeze the whole application rather than this page.
    ///
    /// The buttons are deliberately *not* disabled while an edit is in flight. Blazor
    /// serialises handlers on the circuit, so an impatient second click on "move up"
    /// is applied to the already-updated queue and moves the slot a second place —
    /// which is what the user meant.
    /// </remarks>
    /// <returns>
    /// Whether anything actually changed, so a caller only announces what happened
    /// when it did. The service reports a no-op for a move that was already at that
    /// end, or a slot the queue no longer holds.
    /// </returns>
    private async Task<bool> ApplyAsync(string title, Func<Task<bool>> edit)
    {
        var changed = await _busy.RunAsync(title, _ => edit());

        if (changed)
        {
            await RefreshAsync();
        }

        return changed;
    }

    private Task MoveAsync(QueueListItem item, QueueMove move)
    {
        // No confirmation, because the new order is the confirmation. A message on
        // every press of four buttons would be noise over the thing it describes.
        return ApplyAsync(
            "Reordering Up Next",
            () => QueueService.MoveAsync(Profile.DefaultProfileId, item.QueueItemId, move));
    }

    private async Task AskToRemoveAsync(QueueListItem item)
    {
        _pendingRemoval = item;

        // Rendered before showModal, so the dialog the platform focuses into already
        // has its title and its buttons in it.
        StateHasChanged();

        _dialogModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Shared/ShowDetailDialog.razor.js");

        await _dialogModule.InvokeVoidAsync("showModal", _confirmDialog);
    }

    private async Task CancelRemoveAsync()
    {
        _pendingRemoval = null;

        if (_dialogModule is not null)
        {
            await _dialogModule.InvokeVoidAsync("close", _confirmDialog);
        }
    }

    private async Task ConfirmRemoveAsync()
    {
        if (_pendingRemoval is not { } item)
        {
            return;
        }

        // Closed before the work starts, because the work puts up a modal of its own
        // and two of them at once leaves the second behind the first's backdrop.
        await CancelRemoveAsync();

        if (await ApplyAsync(
                "Removing from Up Next",
                () => QueueService.RemoveAsync(Profile.DefaultProfileId, item.QueueItemId)))
        {
            // Worth saying plainly. Removing from the queue is a decision about
            // order, not about the library, and the row simply vanishing does not
            // distinguish the two.
            await _toasts.ShowAsync($"Removed {item.Title}. It is still in your library.");
        }
    }

    private async Task RefreshAsync()
    {
        Queue = await QueueService.GetQueueAsync(Profile.DefaultProfileId);

        // Only when there is nothing to show. The two empty states differ, so the
        // count has to be read to tell them apart — but a queue with rows in it has
        // already answered the question, and this is the page every visit starts on.
        _libraryIsEmpty = Queue.Count == 0
            && (await LibraryService.GetSummaryAsync(Profile.DefaultProfileId)).Total == 0;
    }

    /// <summary>
    /// The queue's length and, where it can be known, how long it would take to
    /// watch all of it. Partial totals say so rather than reading as exact.
    /// </summary>
    private string SummaryText()
    {
        if (Queue is null)
        {
            return string.Empty;
        }

        var count = $"{Queue.Count} {(Queue.Count == 1 ? "title" : "titles")}";

        var (minutes, isPartial) = RuntimeCalculator.Sum(Queue.Select(i => i.EstimatedRuntimeMinutes));

        // Anything with an unknown length was left out of the sum by the calculator,
        // so a partial total is a floor, not an estimate.
        return RuntimeCalculator.Format(minutes) is { } total
            ? $"{count} · {(isPartial ? "at least " : string.Empty)}{total} to watch"
            : count;
    }

    /// <summary>
    /// The facts the card can afford, joined, with the unknown ones left out.
    /// </summary>
    /// <remarks>
    /// The queue's version of the backlog's line, and shorter by one: there is no
    /// media type here, because what is in the queue is what you are about to watch
    /// rather than something being chosen between. Hidden below 720px like the
    /// backlog's, and in the dialog either way.
    /// </remarks>
    private static string FactsText(QueueListItem item)
    {
        var parts = new List<string>(2);

        if (RuntimeCalculator.Format(item.EstimatedRuntimeMinutes) is { } runtime)
        {
            parts.Add(runtime);
        }

        if (item.EpisodeCount is { } total)
        {
            parts.Add($"{item.EpisodesWatched} / {total}");
        }
        else if (item.EpisodesWatched > 0)
        {
            parts.Add($"{item.EpisodesWatched} watched");
        }

        return string.Join(" · ", parts);
    }
}
