@* Statically rendered for the same reason the sign-in page is: setting a password
   re-issues the caller's own cookie, and a cookie is set on an HTTP response that
   an interactive component has already sent. Keeping it here also keeps the
   credential off the circuit entirely. *@
@page "/password"
@layout SignedOutLayout

@using System.ComponentModel.DataAnnotations
@using AniQueue.Core.Security
@using AniQueue.Web.Security
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Components.Endpoints

@attribute [ExcludeFromInteractiveRouting]

@inject IAuthService Auth
@inject NavigationManager Navigation

<PageTitle>Password — AniQueue</PageTitle>

<h1>Password</h1>

@if (Done is not null)
{
    <div class="notice success" role="status">
        @(Done switch
        {
            "set" => "AniQueue is locked. You will need this password on your other devices.",
            "changed" => "Password changed. Everywhere else has been signed out.",
            "cleared" => "Password removed. AniQueue is open to anybody who can reach it.",
            _ => "Done."
        })
    </div>
}

@if (_locked)
{
    <p>
        AniQueue asks for a password before it shows anything. Changing it signs out
        every other device.
    </p>
}
else
{
    <p>
        AniQueue has no password, so anybody who can reach this address can read your
        library and change it. Setting one is what turns the lock on.
    </p>
}

<EditForm Model="Input" OnValidSubmit="SetAsync" FormName="set-password" method="post">
    <DataAnnotationsValidator />

    <label for="password">@(_locked ? "New password" : "Password")</label>
    <InputText id="password" type="password" class="password" autocomplete="new-password"
               @bind-Value="Input!.Password" />
    <ValidationMessage For="() => Input!.Password" />

    <label for="confirm">Type it again</label>
    <InputText id="confirm" type="password" class="password" autocomplete="new-password"
               @bind-Value="Input!.Confirm" />
    <ValidationMessage For="() => Input!.Confirm" />

    <button type="submit" class="primary">@(_locked ? "Change password" : "Set password")</button>
</EditForm>

@if (_locked)
{
    <hr />

    <EditForm Model="_nothing" OnValidSubmit="ClearAsync" FormName="clear-password" method="post">
        <p class="muted">
            Removing the password opens AniQueue to anybody who can reach it, which is
            how it ran before you set one.
        </p>

        <button type="submit">Remove the password</button>
    </EditForm>

    <EditForm Model="_nothing" OnValidSubmit="SignOutAsync" FormName="sign-out" method="post">
        <button type="submit">Sign out</button>
    </EditForm>
}

<p><a href="settings">Back to settings</a></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "set-password")]
    private PasswordInput? Input { get; set; }

    /// <summary>What just happened, carried across the redirect that issued the cookie.</summary>
    [SupplyParameterFromQuery(Name = "done")]
    private string? Done { get; set; }

    /// <summary>A model for the two forms that submit nothing but a button press.</summary>
    private readonly object _nothing = new();

    private bool _locked;

    protected override async Task OnInitializedAsync()
    {
        // Assigned here rather than with an initializer: a form post supplies this
        // property, and an initializer runs after that assignment and overwrites it.
        Input ??= new PasswordInput();

        _locked = await Auth.IsLockedAsync(HttpContext.RequestAborted);
    }

    private async Task SetAsync()
    {
        var stamp = await Auth.SetPasswordAsync(Input!.Password!, HttpContext.RequestAborted);

        // The new stamp retires every cookie issued under the old one, including the
        // caller's own — so the person who just changed the password is signed in
        // again here rather than thrown out of the page they are standing on.
        await HttpContext.SignInAsync(
            AniQueueAuth.Scheme,
            AniQueueAuth.PrincipalFor(stamp),
            new AuthenticationProperties { IsPersistent = true });

        Navigation.NavigateTo(_locked ? "/password?done=changed" : "/password?done=set");
    }

    private async Task ClearAsync()
    {
        await Auth.ClearPasswordAsync(HttpContext.RequestAborted);
        await HttpContext.SignOutAsync(AniQueueAuth.Scheme);

        Navigation.NavigateTo("/password?done=cleared");
    }

    private async Task SignOutAsync()
    {
        await HttpContext.SignOutAsync(AniQueueAuth.Scheme);

        Navigation.NavigateTo("/login");
    }

    private sealed class PasswordInput
    {
        /// <summary>
        /// Eight characters, which is a floor rather than a policy. Composition rules
        /// push people towards shorter passwords they can remember the mangling of,
        /// and this application has one account on somebody's own network.
        /// </summary>
        [Required(ErrorMessage = "Enter a password.")]
        [MinLength(8, ErrorMessage = "Use at least eight characters.")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Type the password again.")]
        [Compare(nameof(Password), ErrorMessage = "The two do not match.")]
        public string? Confirm { get; set; }
    }
}
