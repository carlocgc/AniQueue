@* Statically rendered for the same reason the sign-in page is: setting a password
   re-issues the caller's own cookie, and a cookie is set on an HTTP response that
   an interactive component has already sent. Keeping it here also keeps the
   credential off the circuit entirely. *@
@page "/password"
@layout SignedOutLayout

@using System.ComponentModel.DataAnnotations
@using AniQueue.Core.Security
@using AniQueue.Infrastructure.Settings
@using AniQueue.Web.Security
@using AniQueue.Web.Services
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Endpoints

@attribute [ExcludeFromInteractiveRouting]

@* Its own policy rather than the default one. The state that sends everybody here
   is the one where nobody can sign in, so the default policy would redirect this
   page to itself; anonymous would let a stranger change the password of a locked
   application. This passes when the lock is not yet holding anything, or when the
   caller has signed in. *@
@attribute [Authorize(Policy = AniQueueAuth.PasswordPolicy)]

@inject IAuthService Auth
@inject NavigationManager Navigation
@inject UserConfigStatus UserConfig

<PageTitle>Password — AniQueue</PageTitle>

<h1>Password</h1>

@if (_settingsError is not null)
{
    <div class="notice error" role="alert">
        <strong>Your password was saved, but the switch that turns the lock on was not.</strong>
        <code>@UserConfig.Path</code> could not be written, so AniQueue will not ask for
        it. Fix that and set the password again.
        <div class="muted">@_settingsError</div>
    </div>
}

@switch (_state)
{
    case AuthState.Locked:
        <p>
            AniQueue asks for a password before it shows anything. Changing it signs out
            every other device.
        </p>
        break;

    @* Switched on in the file before anybody set one, which is how a container
       started with Auth:Enabled true arrives here. Nobody is locked out, because
       there is nothing to be locked out of yet, so this says what is missing rather
       than refusing anybody. *@
    case AuthState.NeedsPassword:
        <p>
            <strong>AniQueue is set to ask for a password and there is no password to ask
            for.</strong> Every page sends you here until you set one. To leave it open
            instead, put <code>"Auth:Enabled": false</code> in <code>@UserConfig.Path</code>.
        </p>
        break;

    default:
        <p>
            AniQueue has no password, so anybody who can reach this address can read your
            library and change it. Setting one is what turns the lock on.
        </p>
        break;
}

<EditForm Model="Input" OnValidSubmit="SetAsync" FormName="set-password" method="post">
    <DataAnnotationsValidator />

    <label for="password">@(_state is AuthState.Locked ? "New password" : "Password")</label>
    <InputText id="password" type="password" class="password" autocomplete="new-password"
               @bind-Value="Input!.Password" />
    <ValidationMessage For="() => Input!.Password" />

    <label for="confirm">Type it again</label>
    <InputText id="confirm" type="password" class="password" autocomplete="new-password"
               @bind-Value="Input!.Confirm" />
    <ValidationMessage For="() => Input!.Confirm" />

    <button type="submit" class="primary">
        @(_state is AuthState.Locked ? "Change password" : "Set password")
    </button>
</EditForm>

@if (_state is AuthState.Locked)
{
    <hr />

    <EditForm Model="_nothing" OnValidSubmit="RemoveAsync" FormName="remove-password" method="post">
        <p class="muted">
            Removing the password opens AniQueue to anybody who can reach it, which is
            how it ran before you set one.
        </p>

        <button type="submit">Remove the password</button>
    </EditForm>

    <EditForm Model="_nothing" OnValidSubmit="SignOutAsync" FormName="sign-out" method="post">
        <button type="submit">Sign out</button>
    </EditForm>
}

<p><a href="settings">Back to settings</a></p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "set-password")]
    private PasswordInput? Input { get; set; }

    /// <summary>A model for the two forms that submit nothing but a button press.</summary>
    private readonly object _nothing = new();

    private AuthState _state;

    private string? _settingsError;

    protected override async Task OnInitializedAsync()
    {
        // Assigned here rather than with an initializer: a form post supplies this
        // property, and an initializer runs after that assignment and overwrites it.
        Input ??= new PasswordInput();

        _state = await Auth.GetStateAsync(HttpContext.RequestAborted);
    }

    private async Task SetAsync()
    {
        var changed = await Auth.SetPasswordAsync(Input!.Password!, HttpContext.RequestAborted);

        // The new stamp retires every cookie issued under the old one, including the
        // caller's own, so the person who just set the password is signed in again
        // here rather than thrown out of the page they are standing on.
        await HttpContext.SignInAsync(
            AniQueueAuth.Scheme,
            AniQueueAuth.PrincipalFor(changed.Stamp!),
            new AuthenticationProperties { IsPersistent = true });

        if (changed.SettingsError is not null)
        {
            // Said here rather than through the redirect, because it is the one
            // outcome where what the page would report next is not what happened.
            _settingsError = changed.SettingsError;
            _state = await Auth.GetStateAsync(HttpContext.RequestAborted);

            return;
        }

        // Into the application rather than back to this page. Landing here again on a
        // page headed Password, under a message about needing it on your other
        // devices, reads like being shut out by the thing you just switched on.
        Navigation.NavigateTo(_state is AuthState.Locked
            ? $"/?{Confirmation.Parameter}={Confirmation.PasswordChanged}"
            : $"/?{Confirmation.Parameter}={Confirmation.PasswordSet}");
    }

    private async Task RemoveAsync()
    {
        var changed = await Auth.RemovePasswordAsync(HttpContext.RequestAborted);

        await HttpContext.SignOutAsync(AniQueueAuth.Scheme);

        if (changed.SettingsError is not null)
        {
            _settingsError = changed.SettingsError;
            _state = await Auth.GetStateAsync(HttpContext.RequestAborted);

            return;
        }

        Navigation.NavigateTo($"/?{Confirmation.Parameter}={Confirmation.PasswordRemoved}");
    }

    private async Task SignOutAsync()
    {
        await HttpContext.SignOutAsync(AniQueueAuth.Scheme);

        Navigation.NavigateTo(AniQueueAuth.LoginPath);
    }

    private sealed class PasswordInput
    {
        /// <summary>
        /// Eight characters, which is a floor rather than a policy. Composition rules
        /// push people towards shorter passwords they can remember the mangling of,
        /// and this application has one account on somebody's own network.
        /// </summary>
        [Required(ErrorMessage = "Enter a password.")]
        [MinLength(8, ErrorMessage = "Use at least eight characters.")]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Type the password again.")]
        [Compare(nameof(Password), ErrorMessage = "The two do not match.")]
        public string? Confirm { get; set; }
    }
}
