@page "/"
@inject ILibraryService LibraryService

<PageTitle>AniQueue</PageTitle>

<div class="page-header">
    <h1>Dashboard</h1>
    <p>What to watch next, decided deliberately rather than by scrolling.</p>
</div>

@if (_summary is null)
{
    <div class="empty-state" aria-live="polite">Loading…</div>
}
else if (_summary.Total == 0)
{
    <div class="card">
        <div class="empty-state">
            <p>Nothing here yet. Import your existing library to get started.</p>
            <a class="button" href="import">Import a MyAnimeList export</a>
        </div>
    </div>
}
else
{
    <div class="stat-row">
        <div class="stat">
            <div class="value">@_summary.Total</div>
            <div class="label">In library</div>
        </div>
        <div class="stat">
            <div class="value">@_summary.Of(LibraryStatus.Watching)</div>
            <div class="label">Watching</div>
        </div>
        <div class="stat">
            <div class="value">@_summary.Of(LibraryStatus.Planning)</div>
            <div class="label">Backlog</div>
        </div>
        <div class="stat">
            <div class="value">@_summary.Of(LibraryStatus.Completed)</div>
            <div class="label">Completed</div>
        </div>
        <div class="stat">
            <div class="value">@_summary.Of(LibraryStatus.OnHold)</div>
            <div class="label">On hold</div>
        </div>
        <div class="stat">
            <div class="value">@_summary.Of(LibraryStatus.Dropped)</div>
            <div class="label">Dropped</div>
        </div>
    </div>

    @* Currently Watching, Up Next and Suggested Next arrive with Phases 4, 6 and 7.
       Stating that is more useful than showing empty placeholder panels. *@
    <div class="card">
        <h2>Coming next</h2>
        <p class="muted">
            The Up Next queue, watching progress and recommendations are being built
            in later phases. For now, the
            <a href="backlog">backlog</a> shows everything you have imported.
        </p>
    </div>
}

@code {
    private LibrarySummary? _summary;

    protected override async Task OnInitializedAsync() =>
        _summary = await LibraryService.GetSummaryAsync(Profile.DefaultProfileId);
}
