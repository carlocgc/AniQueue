@page "/"
@inject ILibraryService LibraryService

<PageTitle>AniQueue</PageTitle>

<div class="page-header">
    <h1>Dashboard</h1>
    <p>What to watch next, decided deliberately rather than by scrolling.</p>
</div>

@if (Summary is null)
{
    <div class="empty-state" aria-live="polite">Loading…</div>
}
else if (Summary.Total == 0)
{
    <div class="card">
        <div class="empty-state">
            @* The first screen of a fresh install, and now the only one — nothing is
               seeded any more (D27). One destination rather than two, since Sources
               owns every way in: AniQueue assumes the library already exists
               somewhere (D11), and that page is where you say where. *@
            <p>Nothing here yet. Bring your library in from wherever it already lives.</p>
            <div class="toolbar">
                <a class="button primary" href="sources">Bring in your library</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="stat-row">
        <div class="stat">
            <div class="value">@Summary.Total</div>
            <div class="label">In library</div>
        </div>
        <div class="stat">
            <div class="value">@Summary.Of(LibraryStatus.Watching)</div>
            <div class="label">Watching</div>
        </div>
        <div class="stat">
            <div class="value">@Summary.Of(LibraryStatus.Planning)</div>
            <div class="label">Backlog</div>
        </div>
        <div class="stat">
            <div class="value">@Summary.Of(LibraryStatus.Completed)</div>
            <div class="label">Completed</div>
        </div>
        <div class="stat">
            <div class="value">@Summary.Of(LibraryStatus.OnHold)</div>
            <div class="label">On hold</div>
        </div>
        <div class="stat">
            <div class="value">@Summary.Of(LibraryStatus.Dropped)</div>
            <div class="label">Dropped</div>
        </div>
    </div>

    @* There is no Currently Watching, Up Next preview or Suggested Next panel here,
       and none is coming (D32). The card that used to promise them was written when
       they were a phase; both signals they would have ranked on were removed by
       decisions taken since — manual priority by D14, and the AI score does not
       exist until a scoring run has been applied.

       So the dashboard is counts, and the pages that do the work are one click away
       in the sidebar. Repeating those links in a card here would be a second route
       to the same two places, which is the kind of thing that drifts. *@
}

@code {
    // Carried from the prerender into the interactive render (see Backlog.razor for
    // the full reasoning). Without it, OnInitializedAsync runs a second time when
    // the circuit attaches, and the component briefly renders "Loading…" — replacing
    // the prerendered markup with a structurally different tree at the exact moment
    // the client is binding to it.
    [PersistentState]
    public LibrarySummary? Summary { get; set; }

    protected override async Task OnInitializedAsync() =>
        Summary ??= await LibraryService.GetSummaryAsync(Profile.DefaultProfileId);
}
