@page "/backlog"
@using System.Globalization
@using AniQueue.Core.Queue
@using AniQueue.Core.Recommendations
@inject ILibraryService LibraryService
@inject IRelationService RelationService
@inject IQueueService QueueService
@inject IRecommendationService Scoring

<PageTitle>Backlog — AniQueue</PageTitle>

<div class="page-header">
    <h1>Backlog</h1>
    <p>What you intend to watch. Narrow it down, then send things to Up Next.</p>
</div>

@* Rows here change under a background sync too — a title's status moves, or a new
   one appears — and the filters make it worse: a page filtered to Planning can be
   showing something that finished watching an hour ago. *@
<StaleLibraryNotice OnRefresh="ReloadAsync" />

@* No busy dialog here any more (D26). Every write this page makes is now one row's
   worth, so a modal covering the page to announce it would be more disruptive than
   the wait it describes — and it was the bulk actions, gone with the checkboxes,
   that needed to be kept off the circuit thread. *@

@if (Facets is null || Page is null)
{
    <div class="empty-state" aria-live="polite">Loading…</div>
}
else if (Facets.IsEmpty)
{
    @* No filter bar over a library with nothing in it. Beyond being noise — a
       search box, a sort order and "0 entries" above a message saying there is
       nothing here — it was actively wrong: the backlog defaults to Planning, and
       an empty library has no Planning count, so the status picker rendered with a
       selected value matching none of its options and drew itself blank (D27). *@
    <div class="card">
        <div class="empty-state">
            <p>Your library is empty. Bring it in from wherever it already lives.</p>
            <div class="toolbar">
                <a class="button primary" href="sources">Bring in your library</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="card filters">
        <div class="toolbar">
            <input type="search" placeholder="Search titles" value="@_query.Search"
                   @oninput="OnSearchChangedAsync" aria-label="Search titles" />

            @* One control for "which slice am I looking at", statuses and the hidden
               list together. Hiding used to be a chip among the filters, which put
               the only route back to a set-aside title in the same row as "Under 2
               hours" — findable if you already knew, and not otherwise. It is
               separated into its own group because it is a different axis: an entry
               is hidden *and* Planning, not hidden *instead of* it. *@
            <select value="@_statusValue" @onchange="OnStatusChangedAsync" aria-label="Show">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<LibraryStatus>())
                {
                    var count = Facets.CountByStatus.GetValueOrDefault(status);
                    @* Statuses the library does not contain are not offered. *@
                    if (count > 0)
                    {
                        <option value="@status">@status (@count)</option>
                    }
                }

                @* Offered while anything is hidden — and while it is being looked at
                   even once nothing is, because unhiding the last entry must not
                   pull the selected option out from under the user. *@
                @if (Facets.HasHiddenEntries || _query.HiddenOnly)
                {
                    <optgroup label="Set aside">
                        <option value="@HiddenValue">Hidden (@Facets.HiddenCount)</option>
                    </optgroup>
                }
            </select>

            <select value="@_query.Sort" @onchange="OnSortChangedAsync" aria-label="Sort by">
                <option value="@LibrarySort.TitleAscending">Title A–Z</option>
                <option value="@LibrarySort.TitleDescending">Title Z–A</option>
                @if (Facets.HasRecommendations)
                {
                    <option value="@LibrarySort.RecommendationDescending">AI rank</option>
                }
                @if (Facets.HasRuntimeData)
                {
                    <option value="@LibrarySort.RuntimeAscending">Shortest first</option>
                    <option value="@LibrarySort.RuntimeDescending">Longest first</option>
                }
                <option value="@LibrarySort.YearDescending">Newest</option>
                <option value="@LibrarySort.YearAscending">Oldest</option>
                @if (Facets.HasUserScores)
                {
                    <option value="@LibrarySort.UserScoreDescending">My score</option>
                }
                <option value="@LibrarySort.DateAddedDescending">Recently added</option>
            </select>

            <span class="muted">@EntryCountText()</span>

            @if (_query.HasActiveFilters)
            {
                <button @onclick="ClearFiltersAsync">Clear filters</button>
            }
        </div>

        @* Quick filters are rendered only when the metadata behind them exists. A
           "Movie" chip in a library with no films can only ever return nothing,
           and an empty result reads as "I own none" rather than "this control is
           useless here". *@
        <div class="chips" role="group" aria-label="Quick filters">
            @if (Facets.HasRuntimeData)
            {
                <button class="chip @Active(_query.MaxRuntimeMinutes == 120)"
                        @onclick="() => ToggleRuntimeAsync(120)">Under 2 hours</button>
                <button class="chip @Active(_query.MaxRuntimeMinutes == 360)"
                        @onclick="() => ToggleRuntimeAsync(360)">Under 6 hours</button>
            }

            @* Beside the runtime chips on purpose: both answer "what can I start
               tonight without signing up for something". Offered only once the
               relation graph holds a prequel or sequel edge, or it would match every
               row and read as "my whole library is standalone" (D24). *@
            @if (Facets.HasSequelEdges)
            {
                <button class="chip @Active(_query.StandaloneOnly)"
                        @onclick="ToggleStandaloneAsync">Standalone</button>
            }

            @foreach (var mediaType in Facets.MediaTypes)
            {
                <button class="chip @Active(_query.MediaType == mediaType)"
                        @onclick="() => ToggleMediaTypeAsync(mediaType)">@MediaTypeLabel(mediaType)</button>
            }

            @foreach (var decade in Facets.Decades)
            {
                <button class="chip @Active(_query.Decade == decade)"
                        @onclick="() => ToggleDecadeAsync(decade)">@DecadeLabel(decade)</button>
            }

            @if (Facets.HasRecommendations)
            {
                <button class="chip @Active(_query.MinRecommendationConfidence is not null)"
                        @onclick="ToggleHighConfidenceAsync">High AI confidence</button>
            }

            @if (Facets.HasUnrankedEntries && Facets.HasRecommendations)
            {
                <button class="chip @Active(_query.HasRecommendation == false)"
                        @onclick="ToggleUnrankedAsync">Not yet ranked</button>
            }

            @if (Facets.Sources.Count > 1)
            {
                @foreach (var source in Facets.Sources)
                {
                    <button class="chip @Active(_query.Source == source)"
                            @onclick="() => ToggleSourceAsync(source)">@source</button>
                }
            }
        </div>
    </div>

    @* No selection bar, and nothing appears above the table when a row is acted on
       (D26). Every action lives on the row it acts on: a control that materialises
       at the top of a fifty-row page is out of reach of the row that summoned it,
       and the feedback is the row changing under the cursor rather than a sentence
       somewhere else. *@

    @if (Page.Items.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                @* An empty hidden list is the expected end state rather than a dead
                   end — it is what unhiding the last entry looks like — so it says
                   so instead of offering to clear filters that are not the reason. *@
                @* An empty library never reaches here — it is answered above, before
                   the filter bar is drawn at all. *@
                @if (_query.HiddenOnly)
                {
                    <p>Nothing is hidden.</p>
                }
                else
                {
                    <p>Nothing matches those filters.</p>
                    <button @onclick="ClearFiltersAsync">Clear filters</button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            @* No header text on any control column: each holds a
                               control per row, and naming them would put a word above
                               fifty chevrons.

                               Adding leads the row and hiding ends it, with the whole
                               table between them. They were adjacent, which put the
                               action done constantly a few pixels from the one that
                               takes a title out of the list — and both are small icon
                               buttons, so the only thing separating them was aim. *@
                            <th class="add-col"></th>
                            <th class="expand-col"></th>
                            <th>Title</th>
                            <th>Type</th>
                            <th class="numeric">Year</th>
                            <th class="numeric">Runtime</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th class="numeric">Score</th>
                            @if (Facets.HasRecommendations)
                            {
                                <th class="numeric">AI</th>
                            }
                            <th class="actions-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Page.Items)
                        {
                            <tr class="@(IsHidden(item) ? "row-hidden" : null)">
                                <td class="add-col">
                                    @* Present on every row and disabled where it cannot
                                       work, rather than absent: a control that comes and
                                       goes down a column is harder to aim at than one
                                       that is always in the same place, and a disabled
                                       button carries the reason in its tooltip where an
                                       absent one carries nothing. *@
                                    <QueueButton AnimeId="item.AnimeId" Title="@item.Title"
                                                 Status="item.Status" IsQueued="IsQueued(item.AnimeId)"
                                                 OnToggle="ToggleQueuedAsync" />
                                </td>
                                <td class="expand-col">
                                    @* Drawn only when there is something to open. A
                                       control that sometimes does nothing teaches
                                       people to stop pressing it, which would cost
                                       exactly the discoverability this phase is for
                                       (D24). *@
                                    @if (RelatedCount(item.AnimeId) is { } count)
                                    {
                                        @* aria-expanded is spelled out rather than bound to
                                           the bool: Blazor renders a true bool attribute with
                                           an empty value and omits a false one, and an absent
                                           aria-expanded means "this does not expand" rather
                                           than "closed". aria-controls is set only while the
                                           row it names exists, since a dangling one points
                                           assistive technology at nothing. *@
                                        <button class="expander @(IsExpanded(item.AnimeId) ? "open" : null)"
                                                @onclick="() => ToggleRelatedAsync(item.AnimeId)"
                                                aria-expanded="@(IsExpanded(item.AnimeId) ? "true" : "false")"
                                                aria-controls="@(IsExpanded(item.AnimeId) ? RelatedRowId(item.AnimeId) : null)"
                                                title="@RelatedLabel(item, count, IsExpanded(item.AnimeId))"
                                                aria-label="@RelatedLabel(item, count, IsExpanded(item.AnimeId))">
                                            <span class="chevron" aria-hidden="true"></span>
                                            <span class="count">@count</span>
                                        </button>
                                    }
                                </td>
                                <td>
                                    <div class="title-cell">
                                        <span>@item.Title</span>
                                        @* Both badges read the page's own state rather than
                                           what the query returned, so a row acted on says so
                                           immediately without the list being re-read under
                                           the cursor (D26). *@
                                        @if (IsQueued(item.AnimeId))
                                        {
                                            <span class="badge queued" title="Already in Up Next">Queued</span>
                                        }
                                        @if (IsHidden(item))
                                        {
                                            <span class="badge">Hidden</span>
                                        }
                                    </div>
                                    <div class="row-meta">
                                        @* Free: the identifiers are already stored, so this is
                                           formatting rather than a lookup.

                                           One badge per site, because a title can be known to
                                           more than one (D17) — anything AniList has bridged
                                           carries a MyAnimeList id as well, and offering both
                                           beats picking one.

                                           A badge rather than a sentence: it sits among the
                                           other row badges, where prose reads as description
                                           instead of as something clickable. The short name
                                           is the label; the accessible name spells the site
                                           out, because "MAL" announced on its own is jargon. *@
                                        @foreach (var link in item.SourceLinks)
                                        {
                                            <a class="badge badge-link" href="@link.Url"
                                               target="_blank" rel="noopener noreferrer"
                                               title="@link.DescribeFor(item.Title)"
                                               aria-label="@link.DescribeFor(item.Title)">
                                                @link.ShortName<ExternalLinkIcon />
                                            </a>
                                        }
                                    </div>
                                </td>
                                @* Missing metadata degrades to an em dash rather than
                                   filling the table with "N/A". *@
                                <td>@(item.MediaType == MediaType.Unknown ? "—" : MediaTypeLabel(item.MediaType))</td>
                                <td class="numeric">@(item.ReleaseYear?.ToString() ?? "—")</td>
                                <td class="numeric">@(RuntimeCalculator.Format(item.EstimatedRuntimeMinutes) ?? "—")</td>
                                <td><span class="badge @item.Status.ToString().ToLowerInvariant()">@item.Status</span></td>
                                <td>@ProgressText(item)</td>
                                <td class="numeric">@(item.UserScore?.ToString() ?? "—")</td>
                                @if (Facets.HasRecommendations)
                                {
                                    <td class="numeric">
                                        @* The score stays legible in the row: it is the
                                           column's whole job, and a listing sorted by it
                                           that made you open something to read it would
                                           be unusable. The button is the number, with a
                                           chevron beside it.

                                           Offered only where there is something behind
                                           it — an unscored row has nothing to explain,
                                           and a control that opens an empty panel is
                                           worse than no control. *@
                                        @if (item.RecommendationScore is { } score)
                                        {
                                            <button class="score-expander @(IsScoring(item.AnimeId) ? "open" : null)"
                                                    @onclick="() => ToggleScoringAsync(item.AnimeId)"
                                                    aria-expanded="@(IsScoring(item.AnimeId) ? "true" : "false")"
                                                    aria-controls="@(IsScoring(item.AnimeId) ? ScoringRowId(item.AnimeId) : null)"
                                                    title="@ScoringLabel(item, IsScoring(item.AnimeId))"
                                                    aria-label="@ScoringLabel(item, IsScoring(item.AnimeId))">
                                                <span class="score">@score.ToString("0.0")</span>
                                                <span class="chevron" aria-hidden="true"></span>
                                            </button>
                                        }
                                        else
                                        {
                                            @:—
                                        }
                                    </td>
                                }
                                <td class="actions-col">
                                    <div class="row-actions">
                                        <button class="icon @(IsHidden(item) ? "restore" : null)"
                                                title="@(IsHidden(item) ? "Show again in listings" : "Hide from listings")"
                                                aria-label="@(IsHidden(item)
                                                    ? $"Show {item.Title} in listings again"
                                                    : $"Hide {item.Title} from listings")"
                                                @onclick="() => SetHiddenAsync(item, !IsHidden(item))">@(IsHidden(item) ? "↺" : "⊘")</button>
                                    </div>
                                </td>
                            </tr>

                            @if (IsScoring(item.AnimeId))
                            {
                                @* Its own row, the same shape the relatives use, and for
                                   the same reason: this explains the title above it and
                                   detaching it into a floating panel would put a
                                   paragraph of reasoning somewhere it has to be dismissed
                                   rather than read.

                                   A tooltip was the other candidate and is the wrong
                                   tool here — it cannot hold a heading, it is gone on
                                   touch, and this is several fields rather than a
                                   caption. *@
                                <tr class="scoring-row" id="@ScoringRowId(item.AnimeId)">
                                    <td></td>
                                    <td colspan="@(ColumnCount - 1)">
                                        @if (_scoring.TryGetValue(item.AnimeId, out var detail))
                                        {
                                            @if (detail is null)
                                            {
                                                @* The score is on the entry but no applied
                                                   run mentions this title — the history was
                                                   cleared, or the row was scored by a build
                                                   that kept no run. Said plainly rather
                                                   than shown as an empty panel. *@
                                                <p class="muted">
                                                    This score is on the title, but the ranking that
                                                    produced it is no longer on record.
                                                </p>
                                            }
                                            else
                                            {
                                                <div class="scoring-detail">
                                                    <h3>Why this score</h3>

                                                    @if (detail.Reason is { } reason)
                                                    {
                                                        <p class="reason">@reason</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="muted">The model gave no reason for this one.</p>
                                                    }

                                                    @* A definition list, because every line is a
                                                       label and its value — and it is what lets the
                                                       fields stay readable when the panel narrows. *@
                                                    @* Each pair wrapped in a div — permitted in a
                                                       dl since HTML5, and necessary here: flexing
                                                       the list itself would make every dt and dd
                                                       its own item, so a label could wrap onto a
                                                       different line from its value. *@
                                                    <dl class="scoring-facts">
                                                        <div>
                                                            <dt>Confidence</dt>
                                                            <dd>@Percent(detail.Confidence)</dd>
                                                        </div>
                                                        <div>
                                                            <dt>Ranked</dt>
                                                            <dd>@detail.Rank of @detail.CandidateCount</dd>
                                                        </div>
                                                        <div>
                                                            <dt>Decided</dt>
                                                            <dd>@Determined(detail.DeterminedAt)</dd>
                                                        </div>
                                                        <div>
                                                            <dt>By</dt>
                                                            <dd>@(detail.ModelIdentifier ?? detail.ProviderName)</dd>
                                                        </div>
                                                    </dl>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="muted" aria-live="polite">Loading…</p>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (IsExpanded(item.AnimeId))
                            {
                                @* A row of its own rather than a floating panel: the
                                   relatives belong to the title above them, and
                                   anything that detached them from it would be a
                                   grouping by another name (D24). *@
                                <tr class="relations-row" id="@RelatedRowId(item.AnimeId)">
                                    <td></td>
                                    <td colspan="@(ColumnCount - 1)">
                                        @* The one control that acts on more than one title,
                                           and it lives here rather than on the row because
                                           the panel is where a run of seasons is visible —
                                           an action that queues several things belongs
                                           beside the list of what they are (D26).

                                           Offered only when it would do more than the row's
                                           own button already does: at one title it is that
                                           button with a longer name, and at none there is
                                           nothing left to queue. *@
                                        @if (SequelsToQueue(item.AnimeId) is > 1 and var toQueue)
                                        {
                                            <p class="relations-action">
                                                <button class="follow"
                                                        title="@FollowLabel(item.Title, toQueue)"
                                                        aria-label="@FollowLabel(item.Title, toQueue)"
                                                        @onclick="() => QueueWithSequelsAsync(item.AnimeId)">
                                                    Queue this and what follows
                                                    <span class="badge count">@toQueue</span>
                                                </button>
                                                <span class="muted">in release order</span>
                                            </p>
                                        }

                                        @if (_relations.TryGetValue(item.AnimeId, out var relatives))
                                        {
                                            @if (relatives.Count == 0)
                                            {
                                                @* Reachable only if the library changed
                                                   under the page between the count and
                                                   the expansion. *@
                                                <p class="muted">Nothing related that you own.</p>
                                            }
                                            else
                                            {
                                                <ul class="relations">
                                                    @foreach (var relative in relatives)
                                                    {
                                                        <li>
                                                            @* Leads the line, under the
                                                               column the rows put it in, so
                                                               one run of buttons goes down
                                                               the page whether a title is on
                                                               a row or inside an expansion.
                                                               The whole point of finding a
                                                               sequel here is being able to
                                                               act on it (D26), and acting
                                                               leaves the panel open so the
                                                               next one down is still in
                                                               front of the user. *@
                                                            <QueueButton AnimeId="relative.AnimeId" Title="@relative.Title"
                                                                         Status="relative.Status" IsQueued="IsQueued(relative.AnimeId)"
                                                                         OnToggle="ToggleQueuedAsync" />

                                                            @* Then the tag, because it is
                                                               what the line is being read
                                                               for: the question is "how is
                                                               this connected", not "what
                                                               else exists". *@
                                                            <span class="badge relation">@relative.Label</span>
                                                            <span class="relation-title">@relative.Title</span>
                                                            <span class="badge @relative.Status.ToString().ToLowerInvariant()">@relative.Status</span>
                                                            @if (IsQueued(relative.AnimeId))
                                                            {
                                                                <span class="badge queued" title="Already in Up Next">Queued</span>
                                                            }
                                                            <span class="muted">@RelativeMeta(relative)</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        }
                                        else
                                        {
                                            <p class="muted" aria-live="polite">Loading…</p>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Page.TotalCount > PageSize)
        {
            <div class="toolbar">
                <button @onclick="() => GoToPageAsync(0)" disabled="@(_query.Skip == 0)">First</button>
                <button @onclick="() => GoToPageAsync(_query.Skip - PageSize)" disabled="@(_query.Skip == 0)">Previous</button>
                <span class="muted">
                    @(_query.Skip + 1)–@Math.Min(_query.Skip + PageSize, Page.TotalCount) of @Page.TotalCount
                </span>
                <button @onclick="() => GoToPageAsync(_query.Skip + PageSize)"
                        disabled="@(_query.Skip + PageSize >= Page.TotalCount)">Next</button>
                <button @onclick="() => GoToPageAsync((Page.TotalCount - 1) / PageSize * PageSize)"
                        disabled="@(_query.Skip + PageSize >= Page.TotalCount)">Last</button>
            </div>
        }
    }
}

@code {
    private const int PageSize = 50;

    // Deliberately NOT persisted across the prerender handoff.
    //
    // Persisted state is serialised into the page, sent to the browser and posted
    // back when the circuit starts. A fifty-row page exceeds SignalR's default
    // 32KB receive limit, and the circuit then fails to start at all — the page
    // renders but nothing is interactive, with the failure visible only as a
    // socket close. Raising the limit would be treating the symptom: this would be
    // pushing tens of kilobytes through the browser to avoid one indexed query.
    public LibraryPage? Page { get; set; }

    // Facets are worth carrying: a handful of enums and counts, and they decide
    // which controls exist, so re-querying them causes the filter bar to change
    // shape after first paint.
    [PersistentState]
    public LibraryFacets? Facets { get; set; }

    private LibraryQuery _query = new() { Take = PageSize };

    // What the page has done since it was loaded, overlaid on what the query
    // returned (D26). A row acted on has to say so at once, and re-reading the list
    // to find that out would move rows under the cursor, close every expansion and
    // lose the reader's place — to report a change they just made.
    //
    // Queue membership can be a plain set because a title is either in Up Next or it
    // is not, and the page can say which for anything on screen. Hiding needs an
    // override keyed by title instead: "no answer" has to stay distinguishable from
    // "hidden false", or unhiding a row would be indistinguishable from never having
    // touched it.
    private readonly HashSet<int> _queued = [];
    private readonly Dictionary<int, bool> _hiddenOverride = [];

    // How many relatives each visible row has, so a row with none draws no chevron
    // at all. One grouped query per page, loaded with it (D24).
    private IReadOnlyDictionary<int, int> _relatedCounts = new Dictionary<int, int>();

    // Which rows are open, and what they are showing. Detail is fetched on expand
    // rather than with the page: fifty rows' worth of relatives is a great deal of
    // data to fetch for the one row somebody opens.
    private readonly HashSet<int> _expanded = [];
    private readonly Dictionary<int, IReadOnlyList<RelatedTitle>> _relations = [];

    // How many titles "queue this and what follows" would actually append, per open
    // panel. Read when the panel opens and recomputed after anything queues, so the
    // number on the button is what pressing it will do rather than what it would
    // have done when the panel was opened.
    private readonly Dictionary<int, int> _sequelCounts = [];

    // Which score panels are open, and what each one found. The value is nullable
    // inside a dictionary that records the key: present-with-null means "asked, and
    // no applied run mentions this title", which is a different thing from "not
    // asked yet" and has to render differently.
    private readonly HashSet<int> _scoringOpen = [];
    private readonly Dictionary<int, RecommendationDetail?> _scoring = [];

    /// <summary>
    /// The hidden view's option value.
    /// </summary>
    /// <remarks>
    /// Deliberately not a word <see cref="LibraryStatus"/> could ever parse as, so
    /// that adding a status later cannot silently turn this into one — the parse
    /// below is the only thing separating the two axes sharing this control.
    /// </remarks>
    private const string HiddenValue = "!hidden";

    private string _statusValue =>
        _query.HiddenOnly ? HiddenValue : _query.Status?.ToString() ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Facets ??= await LibraryService.GetFacetsAsync(Profile.DefaultProfileId);

        if (Page is null)
        {
            await LoadPageAsync();
        }
    }

    /// <summary>
    /// Loads the current query's page, and the one thing every row needs to know
    /// about its relatives: whether it has any.
    /// </summary>
    /// <remarks>
    /// Open expansions do not survive this. Reload, paging and every filter change
    /// come through here, and each of them means the rows on screen are a different
    /// set — a panel left open would be showing relatives of a title that has
    /// scrolled out of the result, which is worse than closing it.
    /// </remarks>
    private async Task LoadPageAsync()
    {
        Page = await LibraryService.GetPageAsync(Profile.DefaultProfileId, _query);

        _relatedCounts = await RelationService.GetRelatedCountsAsync(
            Profile.DefaultProfileId,
            [.. Page.Items.Select(i => i.AnimeId)]);

        _expanded.Clear();
        _relations.Clear();
        _sequelCounts.Clear();

        // Cleared with the rest: a reload can change which titles are on the page,
        // and a panel left open against a row that is no longer here would be
        // explaining a score the user cannot see.
        _scoringOpen.Clear();
        _scoring.Clear();

        // The overlay is discarded rather than merged: what just came back from the
        // database is now the truth about these rows, and keeping a local answer on
        // top of it is how a page starts disagreeing with itself.
        _queued.Clear();
        _hiddenOverride.Clear();

        foreach (var item in Page.Items.Where(i => i.IsQueued))
        {
            _queued.Add(item.AnimeId);
        }
    }

    /// <summary>
    /// Re-runs the current query, keeping the filters and the page the user is on.
    /// </summary>
    /// <remarks>
    /// The facets come back too: a background sync can add the first title of a
    /// decade or the first with a known runtime, and those decide which filter
    /// controls exist at all.
    /// </remarks>
    private async Task ReloadAsync()
    {
        Facets = await LibraryService.GetFacetsAsync(Profile.DefaultProfileId);
        await ApplyAsync(_query, resetPaging: false);
    }

    private async Task ApplyAsync(LibraryQuery query, bool resetPaging = true)
    {
        // Any change to what is being shown returns to the first page. Staying on
        // page four of a result set that no longer exists shows an empty table.
        _query = resetPaging ? query with { Skip = 0 } : query;
        await LoadPageAsync();
    }

    private Task OnSearchChangedAsync(ChangeEventArgs e) =>
        ApplyAsync(_query with { Search = e.Value?.ToString() });

    /// <summary>
    /// Switches which slice of the library is listed: a status, everything, or what
    /// has been set aside.
    /// </summary>
    /// <remarks>
    /// The hidden view widens the status to everything rather than keeping whatever
    /// was selected. Hiding is orthogonal to status — an entry is hidden *and*
    /// Planning — so carrying a status into it would silently answer "what have I
    /// set aside" with only part of it, which is the wrong answer for a list whose
    /// whole purpose is finding something to put back.
    /// </remarks>
    private Task OnStatusChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (value == HiddenValue)
        {
            return ApplyAsync(_query with { HiddenOnly = true, Status = null });
        }

        return ApplyAsync(_query with
        {
            HiddenOnly = false,
            Status = Enum.TryParse<LibraryStatus>(value, out var status) ? status : null
        });
    }

    private Task OnSortChangedAsync(ChangeEventArgs e) =>
        ApplyAsync(_query with
        {
            Sort = Enum.TryParse<LibrarySort>(e.Value?.ToString(), out var sort) ? sort : LibrarySort.TitleAscending
        });

    private Task GoToPageAsync(int skip) =>
        ApplyAsync(_query with { Skip = Math.Max(0, skip) }, resetPaging: false);

    /// <summary>Clears the filters, keeping the slice the user chose to look at.</summary>
    private Task ClearFiltersAsync() =>
        ApplyAsync(new LibraryQuery
        {
            Take = PageSize,
            Status = _query.Status,
            HiddenOnly = _query.HiddenOnly
        });

    // Quick filters toggle: pressing an active chip clears it, so a chip is never
    // a trap the user has to hunt for a way out of.
    private Task ToggleRuntimeAsync(int minutes) =>
        ApplyAsync(_query with { MaxRuntimeMinutes = _query.MaxRuntimeMinutes == minutes ? null : minutes });

    private Task ToggleMediaTypeAsync(MediaType mediaType) =>
        ApplyAsync(_query with { MediaType = _query.MediaType == mediaType ? null : mediaType });

    private Task ToggleDecadeAsync(int decade) =>
        ApplyAsync(_query with { Decade = _query.Decade == decade ? null : decade });

    private Task ToggleSourceAsync(AnimeSource source) =>
        ApplyAsync(_query with { Source = _query.Source == source ? null : source });

    private Task ToggleHighConfidenceAsync() =>
        ApplyAsync(_query with
        {
            MinRecommendationConfidence = _query.MinRecommendationConfidence is null ? 0.7 : null
        });

    private Task ToggleUnrankedAsync() =>
        ApplyAsync(_query with { HasRecommendation = _query.HasRecommendation == false ? null : false });

    private Task ToggleStandaloneAsync() =>
        ApplyAsync(_query with { StandaloneOnly = !_query.StandaloneOnly });

    private int? RelatedCount(int animeId) =>
        _relatedCounts.TryGetValue(animeId, out var count) ? count : null;

    private bool IsExpanded(int animeId) => _expanded.Contains(animeId);

    private static string RelatedRowId(int animeId) => $"related-{animeId}";

    private static string ScoringRowId(int animeId) => $"scoring-{animeId}";

    private bool IsScoring(int animeId) => _scoringOpen.Contains(animeId);

    private static string ScoringLabel(LibraryListItem item, bool open) =>
        open ? $"Hide why {item.Title} scored {item.RecommendationScore:0.0}"
             : $"Why {item.Title} scored {item.RecommendationScore:0.0}";

    /// <summary>
    /// Opens or closes a row's scoring detail, fetching it the first time.
    /// </summary>
    /// <remarks>
    /// Cached for the life of the page and not routed through
    /// <see cref="BusyScope"/>, both for the reasons the relatives panel gives: it
    /// is one indexed read about a row already on screen, and a modal to announce it
    /// would be more disruptive than the wait.
    ///
    /// Unlike the relatives, nothing here goes stale while the panel is shut. A
    /// ranking is a fact about a run that has already happened, so the only thing
    /// that could change it is applying another one — which reloads the page.
    /// </remarks>
    private async Task ToggleScoringAsync(int animeId)
    {
        if (!_scoringOpen.Add(animeId))
        {
            _scoringOpen.Remove(animeId);
            return;
        }

        if (_scoring.ContainsKey(animeId))
        {
            return;
        }

        _scoring[animeId] = await Scoring.GetDetailAsync(Profile.DefaultProfileId, animeId);
    }

    private static string Percent(double value) =>
        ((int)Math.Round(value * 100)).ToString(CultureInfo.CurrentCulture) + "%";

    /// <summary>
    /// When a ranking was decided, in local time and in the profile's date format.
    /// </summary>
    private string Determined(DateTimeOffset when) =>
        when.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);

    /// <summary>
    /// Opens or closes a row's relatives, fetching them the first time.
    /// </summary>
    /// <remarks>
    /// Cached for as long as the page lasts, which is until any reload clears it.
    /// Collapsing and reopening the same row is a common way to compare two of
    /// them, and re-querying for it would make the second look slower than the
    /// first for no reason.
    ///
    /// Not routed through <see cref="BusyScope"/>: this is one small indexed read
    /// against a row already on screen, and a modal covering the page to report it
    /// would be far more disruptive than the wait it describes.
    /// </remarks>
    private async Task ToggleRelatedAsync(int animeId)
    {
        if (!_expanded.Add(animeId))
        {
            _expanded.Remove(animeId);
            return;
        }

        // The count is read even when the relatives are already cached, because it is
        // the one thing here that goes out of date while the panel is shut: anything
        // queued elsewhere on the page changes what "and what follows" would still
        // append.
        _sequelCounts[animeId] =
            await RelationService.CountSequelsToQueueAsync(Profile.DefaultProfileId, animeId);

        if (_relations.ContainsKey(animeId))
        {
            return;
        }

        var relatives = await RelationService.GetRelatedAsync(Profile.DefaultProfileId, animeId);

        _relations[animeId] = relatives;

        // Folded into the same set the rows read, so a relative queued from one
        // expansion shows as queued in another that also lists it — and on its own
        // row further down the page.
        foreach (var relative in relatives.Where(r => r.IsQueued))
        {
            _queued.Add(relative.AnimeId);
        }
    }

    private int? SequelsToQueue(int animeId) =>
        _sequelCounts.TryGetValue(animeId, out var count) ? count : null;

    private static string FollowLabel(string title, int count) =>
        $"Queue {title} and everything that follows it — {count} titles, in release order";

    /// <summary>
    /// Queues a title and its unwatched sequels, in one press.
    /// </summary>
    /// <remarks>
    /// The panel stays open and the list is not re-read, as everywhere else on this
    /// page (D26) — but the queued set is read back from the database rather than
    /// guessed at, because this is the one action whose effect the caller cannot
    /// enumerate: it returns how many went in, not which. The queue is small by
    /// design, so asking is cheaper than making the service report a list nothing
    /// else needs.
    /// </remarks>
    private async Task QueueWithSequelsAsync(int animeId)
    {
        await RelationService.AddWithSequelsAsync(Profile.DefaultProfileId, animeId);

        var queued = await QueueService.GetQueuedAnimeIdsAsync(Profile.DefaultProfileId);

        _queued.Clear();
        _queued.UnionWith(queued);

        await RefreshSequelCountsAsync();
    }

    /// <summary>
    /// Re-reads the count behind every open panel's action, so the number on it
    /// still describes what pressing it would do.
    /// </summary>
    /// <remarks>
    /// Bounded by open panels, which is normally one and never many: the button is
    /// the only thing that reads these, and a stale count is a button promising to
    /// queue titles that are already queued.
    /// </remarks>
    private async Task RefreshSequelCountsAsync()
    {
        foreach (var animeId in _sequelCounts.Keys.ToList())
        {
            _sequelCounts[animeId] =
                await RelationService.CountSequelsToQueueAsync(Profile.DefaultProfileId, animeId);
        }
    }

    /// <summary>
    /// The accessible name of a chevron, which has to say whose relatives and how
    /// many — "expand", announced fifty times down a table, says neither.
    /// </summary>
    private static string RelatedLabel(LibraryListItem item, int count, bool expanded)
    {
        var verb = expanded ? "Hide" : "Show";

        return count == 1
            ? $"{verb} the one related title you own for {item.Title}"
            : $"{verb} the {count} related titles you own for {item.Title}";
    }

    /// <summary>
    /// The trailing detail on a relative: type, year, runtime, and progress where
    /// there is any. Absent parts are dropped rather than dashed — an expansion is
    /// prose beside a table, and a run of em dashes in it reads as damage.
    /// </summary>
    private static string RelativeMeta(RelatedTitle relative)
    {
        var parts = new List<string>(4);

        if (relative.MediaType != MediaType.Unknown)
        {
            parts.Add(MediaTypeLabel(relative.MediaType));
        }

        if (relative.ReleaseYear is { } year)
        {
            parts.Add(year.ToString(CultureInfo.InvariantCulture));
        }

        if (RuntimeCalculator.Format(relative.EstimatedRuntimeMinutes) is { } runtime)
        {
            parts.Add(runtime);
        }

        if (relative.EpisodesWatched > 0)
        {
            parts.Add(relative.EpisodeCount is { } total
                ? $"{relative.EpisodesWatched} / {total} watched"
                : $"{relative.EpisodesWatched} watched");
        }

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// How wide an expansion has to stretch. Derived rather than written down,
    /// because a hard-coded number is a colspan that silently goes wrong the next
    /// time a column is added.
    /// </summary>
    private int ColumnCount => Facets is { HasRecommendations: true } ? 11 : 10;

    private bool IsQueued(int animeId) => _queued.Contains(animeId);

    private bool IsHidden(LibraryListItem item) =>
        _hiddenOverride.TryGetValue(item.AnimeId, out var hidden) ? hidden : item.IsHidden;

    /// <summary>
    /// Puts one title into Up Next or takes it out again, from a row or from an
    /// expansion.
    /// </summary>
    /// <remarks>
    /// Nothing is re-read afterwards, and that is the point of doing it this way
    /// (D26). The row is already showing everything the press changed, so re-running
    /// the query would move rows under the cursor, close every open expansion and
    /// lose the reader's place — to tell them about a change they just made.
    ///
    /// The result is still inspected rather than assumed: the page's idea of a
    /// title's status can be a few seconds behind a background sync, so a refusal
    /// leaves the badge alone rather than claiming a slot that was never taken.
    /// Adding something already queued counts as success, because the end state is
    /// the one the button asked for.
    /// </remarks>
    private async Task ToggleQueuedAsync((int AnimeId, bool Queued) request)
    {
        if (request.Queued)
        {
            var result = await QueueService.AddAnimeAsync(Profile.DefaultProfileId, [request.AnimeId]);

            if (result.Added > 0 || result.AlreadyQueued > 0)
            {
                _queued.Add(request.AnimeId);
            }
        }
        else
        {
            // False means the title held no slot, which is the same end state the
            // press asked for — so the button settles rather than staying stuck on
            // "remove".
            await QueueService.RemoveAnimeAsync(Profile.DefaultProfileId, request.AnimeId);

            _queued.Remove(request.AnimeId);
        }

        // A single press changes what the run-queueing action beside it would still
        // do, in either direction: queue season three by hand and the button offering
        // to queue the run has one fewer to add; unqueue it and it has one more.
        await RefreshSequelCountsAsync();
    }

    /// <summary>
    /// Hides or restores one entry, in place.
    /// </summary>
    /// <remarks>
    /// The row stays where it is rather than vanishing, wearing the Hidden badge
    /// until the list is next read. A row that disappeared the instant it was hidden
    /// would look like a delete, and hiding is the one action here that has to be
    /// obviously reversible — so the button that did it stays under the cursor,
    /// offering to undo it.
    ///
    /// The facets are re-read because hiding the first entry is what makes the
    /// "Show hidden" chip exist at all, and unhiding the last is what should take it
    /// away.
    /// </remarks>
    private async Task SetHiddenAsync(LibraryListItem item, bool hidden)
    {
        var result = await LibraryService.SetHiddenAsync(Profile.DefaultProfileId, [item.AnimeId], hidden);

        if (result.Affected == 0)
        {
            return;
        }

        _hiddenOverride[item.AnimeId] = hidden;

        Facets = await LibraryService.GetFacetsAsync(Profile.DefaultProfileId);
    }

    private static string Active(bool isActive) => isActive ? "active" : string.Empty;

    /// <summary>
    /// "80s" and "90s" read naturally; "00s" and "10s" do not, and "0s" — which a
    /// plain two-digit truncation produces for 2000 — is simply wrong. The brief
    /// spells the intended labels out: 80s, 90s, 2000s, 2010s, 2020s.
    /// </summary>
    private static string DecadeLabel(int decade) =>
        decade < 2000
            ? $"{decade % 100:00}s"
            : $"{decade}s";

    private static string MediaTypeLabel(MediaType mediaType) => mediaType switch
    {
        MediaType.Tv => "TV",
        MediaType.Ova => "OVA",
        MediaType.Ona => "ONA",
        _ => mediaType.ToString()
    };

    private string EntryCountText() =>
        Page is null ? string.Empty : $"{Page.TotalCount} {(Page.TotalCount == 1 ? "entry" : "entries")}";

    private static string ProgressText(LibraryListItem item) =>
        item.EpisodeCount is { } total
            ? $"{item.EpisodesWatched} / {total}"
            : item.EpisodesWatched > 0 ? item.EpisodesWatched.ToString() : "—";
}
