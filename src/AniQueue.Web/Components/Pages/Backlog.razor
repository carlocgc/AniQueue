@page "/backlog"
@using System.Globalization
@using AniQueue.Core.Queue
@inject ILibraryService LibraryService
@inject IRelationService RelationService
@inject IQueueService QueueService

<PageTitle>Backlog — AniQueue</PageTitle>

<div class="page-header">
    <h1>Backlog</h1>
    <p>What you intend to watch. Narrow it down, then send things to Up Next.</p>
</div>

@* Rows here change under a background sync too — a title's status moves, or a new
   one appears — and the filters make it worse: a page filtered to Planning can be
   showing something that finished watching an hour ago. *@
<StaleLibraryNotice OnRefresh="ReloadAsync" />

<BusyDialog State="_busy" />

@if (Facets is null || Page is null)
{
    <div class="empty-state" aria-live="polite">Loading…</div>
}
else
{
    <div class="card filters">
        <div class="toolbar">
            <input type="search" placeholder="Search titles" value="@_query.Search"
                   @oninput="OnSearchChangedAsync" aria-label="Search titles" />

            <select value="@_statusValue" @onchange="OnStatusChangedAsync" aria-label="Status">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<LibraryStatus>())
                {
                    var count = Facets.CountByStatus.GetValueOrDefault(status);
                    @* Statuses the library does not contain are not offered. *@
                    if (count > 0)
                    {
                        <option value="@status">@status (@count)</option>
                    }
                }
            </select>

            <select value="@_query.Sort" @onchange="OnSortChangedAsync" aria-label="Sort by">
                <option value="@LibrarySort.TitleAscending">Title A–Z</option>
                <option value="@LibrarySort.TitleDescending">Title Z–A</option>
                @if (Facets.HasRecommendations)
                {
                    <option value="@LibrarySort.RecommendationDescending">AI rank</option>
                }
                @if (Facets.HasRuntimeData)
                {
                    <option value="@LibrarySort.RuntimeAscending">Shortest first</option>
                    <option value="@LibrarySort.RuntimeDescending">Longest first</option>
                }
                <option value="@LibrarySort.YearDescending">Newest</option>
                <option value="@LibrarySort.YearAscending">Oldest</option>
                @if (Facets.HasUserScores)
                {
                    <option value="@LibrarySort.UserScoreDescending">My score</option>
                }
                <option value="@LibrarySort.DateAddedDescending">Recently added</option>
            </select>

            <span class="muted">@EntryCountText()</span>

            @if (_query.HasActiveFilters)
            {
                <button @onclick="ClearFiltersAsync">Clear filters</button>
            }
        </div>

        @* Quick filters are rendered only when the metadata behind them exists. A
           "Movie" chip in a library with no films can only ever return nothing,
           and an empty result reads as "I own none" rather than "this control is
           useless here". *@
        <div class="chips" role="group" aria-label="Quick filters">
            @if (Facets.HasRuntimeData)
            {
                <button class="chip @Active(_query.MaxRuntimeMinutes == 120)"
                        @onclick="() => ToggleRuntimeAsync(120)">Under 2 hours</button>
                <button class="chip @Active(_query.MaxRuntimeMinutes == 360)"
                        @onclick="() => ToggleRuntimeAsync(360)">Under 6 hours</button>
            }

            @* Beside the runtime chips on purpose: both answer "what can I start
               tonight without signing up for something". Offered only once the
               relation graph holds a prequel or sequel edge, or it would match every
               row and read as "my whole library is standalone" (D24). *@
            @if (Facets.HasSequelEdges)
            {
                <button class="chip @Active(_query.StandaloneOnly)"
                        @onclick="ToggleStandaloneAsync">Standalone</button>
            }

            @foreach (var mediaType in Facets.MediaTypes)
            {
                <button class="chip @Active(_query.MediaType == mediaType)"
                        @onclick="() => ToggleMediaTypeAsync(mediaType)">@MediaTypeLabel(mediaType)</button>
            }

            @foreach (var decade in Facets.Decades)
            {
                <button class="chip @Active(_query.Decade == decade)"
                        @onclick="() => ToggleDecadeAsync(decade)">@DecadeLabel(decade)</button>
            }

            @if (Facets.HasRecommendations)
            {
                <button class="chip @Active(_query.MinRecommendationConfidence is not null)"
                        @onclick="ToggleHighConfidenceAsync">High AI confidence</button>
            }

            @if (Facets.HasUnrankedEntries && Facets.HasRecommendations)
            {
                <button class="chip @Active(_query.HasRecommendation == false)"
                        @onclick="ToggleUnrankedAsync">Not yet ranked</button>
            }

            @if (Facets.Sources.Count > 1)
            {
                @foreach (var source in Facets.Sources)
                {
                    <button class="chip @Active(_query.Source == source)"
                            @onclick="() => ToggleSourceAsync(source)">@source</button>
                }
            }

            @if (Facets.HasHiddenEntries)
            {
                <button class="chip @Active(_query.IncludeHidden)"
                        @onclick="ToggleHiddenAsync">Show hidden</button>
            }
        </div>
    </div>

    @if (_selected.Count > 0)
    {
        <div class="card selection-bar" role="region" aria-label="Bulk actions">
            <div class="toolbar">
                <strong>@_selected.Count selected</strong>
                <button class="primary" @onclick="AddSelectedToQueueAsync">Add to Up Next</button>
                <button @onclick="() => SetSelectedHiddenAsync(true)">Hide</button>
                @if (_query.IncludeHidden)
                {
                    <button @onclick="() => SetSelectedHiddenAsync(false)">Unhide</button>
                }
                <button @onclick="ClearSelection">Clear selection</button>
            </div>
            @if (_actionMessage is not null)
            {
                <div class="notice success" role="status">@_actionMessage</div>
            }
        </div>
    }
    else if (_actionMessage is not null)
    {
        <div class="notice success" role="status">@_actionMessage</div>
    }

    @if (Page.Items.Count == 0)
    {
        <div class="card">
            <div class="empty-state">
                @if (_query.HasActiveFilters || _query.Status is not null)
                {
                    <p>Nothing matches those filters.</p>
                    <button @onclick="ClearFiltersAsync">Clear filters</button>
                }
                else
                {
                    <p>Your library is empty.</p>
                    <a class="button primary" href="import">Import a MyAnimeList export</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="select-col">
                                <input type="checkbox" aria-label="Select all on this page"
                                       checked="@AllOnPageSelected"
                                       @onchange="ToggleSelectAll" />
                            </th>
                            @* No header text: the column holds a control per row and
                               naming it would put a word above fifty chevrons. *@
                            <th class="expand-col"></th>
                            <th>Title</th>
                            <th>Type</th>
                            <th class="numeric">Year</th>
                            <th class="numeric">Runtime</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th class="numeric">Score</th>
                            @if (Facets.HasRecommendations)
                            {
                                <th class="numeric">AI</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Page.Items)
                        {
                            <tr class="@(_selected.Contains(item.AnimeId) ? "selected" : null)">
                                <td class="select-col">
                                    <input type="checkbox"
                                           aria-label="@($"Select {item.Title}")"
                                           checked="@_selected.Contains(item.AnimeId)"
                                           @onchange="() => ToggleSelection(item.AnimeId)" />
                                </td>
                                <td class="expand-col">
                                    @* Drawn only when there is something to open. A
                                       control that sometimes does nothing teaches
                                       people to stop pressing it, which would cost
                                       exactly the discoverability this phase is for
                                       (D24). *@
                                    @if (RelatedCount(item.AnimeId) is { } count)
                                    {
                                        @* aria-expanded is spelled out rather than bound to
                                           the bool: Blazor renders a true bool attribute with
                                           an empty value and omits a false one, and an absent
                                           aria-expanded means "this does not expand" rather
                                           than "closed". aria-controls is set only while the
                                           row it names exists, since a dangling one points
                                           assistive technology at nothing. *@
                                        <button class="expander @(IsExpanded(item.AnimeId) ? "open" : null)"
                                                @onclick="() => ToggleRelatedAsync(item.AnimeId)"
                                                aria-expanded="@(IsExpanded(item.AnimeId) ? "true" : "false")"
                                                aria-controls="@(IsExpanded(item.AnimeId) ? RelatedRowId(item.AnimeId) : null)"
                                                title="@RelatedLabel(item, count, IsExpanded(item.AnimeId))"
                                                aria-label="@RelatedLabel(item, count, IsExpanded(item.AnimeId))">
                                            <span class="chevron" aria-hidden="true"></span>
                                            <span class="count">@count</span>
                                        </button>
                                    }
                                </td>
                                <td>
                                    <div class="title-cell">
                                        <span>@item.Title</span>
                                        @if (item.IsQueued)
                                        {
                                            <span class="badge queued" title="Already in Up Next">Queued</span>
                                        }
                                        @if (item.IsHidden)
                                        {
                                            <span class="badge">Hidden</span>
                                        }
                                    </div>
                                    <div class="row-meta">
                                        @* Free: the identifiers are already stored, so this is
                                           formatting rather than a lookup.

                                           One badge per site, because a title can be known to
                                           more than one (D17) — anything AniList has bridged
                                           carries a MyAnimeList id as well, and offering both
                                           beats picking one.

                                           A badge rather than a sentence: it sits among the
                                           other row badges, where prose reads as description
                                           instead of as something clickable. The short name
                                           is the label; the accessible name spells the site
                                           out, because "MAL" announced on its own is jargon. *@
                                        @foreach (var link in item.SourceLinks)
                                        {
                                            <a class="badge badge-link" href="@link.Url"
                                               target="_blank" rel="noopener noreferrer"
                                               title="@link.DescribeFor(item.Title)"
                                               aria-label="@link.DescribeFor(item.Title)">
                                                @link.ShortName<ExternalLinkIcon />
                                            </a>
                                        }
                                    </div>
                                </td>
                                @* Missing metadata degrades to an em dash rather than
                                   filling the table with "N/A". *@
                                <td>@(item.MediaType == MediaType.Unknown ? "—" : MediaTypeLabel(item.MediaType))</td>
                                <td class="numeric">@(item.ReleaseYear?.ToString() ?? "—")</td>
                                <td class="numeric">@(RuntimeCalculator.Format(item.EstimatedRuntimeMinutes) ?? "—")</td>
                                <td><span class="badge @item.Status.ToString().ToLowerInvariant()">@item.Status</span></td>
                                <td>@ProgressText(item)</td>
                                <td class="numeric">@(item.UserScore?.ToString() ?? "—")</td>
                                @if (Facets.HasRecommendations)
                                {
                                    <td class="numeric">@(item.RecommendationScore?.ToString("0.0") ?? "—")</td>
                                }
                            </tr>

                            @if (IsExpanded(item.AnimeId))
                            {
                                @* A row of its own rather than a floating panel: the
                                   relatives belong to the title above them, and
                                   anything that detached them from it would be a
                                   grouping by another name (D24). *@
                                <tr class="relations-row" id="@RelatedRowId(item.AnimeId)">
                                    <td></td>
                                    <td colspan="@(ColumnCount - 1)">
                                        @if (_relations.TryGetValue(item.AnimeId, out var relatives))
                                        {
                                            @if (relatives.Count == 0)
                                            {
                                                @* Reachable only if the library changed
                                                   under the page between the count and
                                                   the expansion. *@
                                                <p class="muted">Nothing related that you own.</p>
                                            }
                                            else
                                            {
                                                <ul class="relations">
                                                    @foreach (var relative in relatives)
                                                    {
                                                        <li>
                                                            @* The tag first, because it is
                                                               what the row is being read
                                                               for: the question is "how is
                                                               this connected", not "what
                                                               else exists". *@
                                                            <span class="badge relation">@relative.Label</span>
                                                            <span class="relation-title">@relative.Title</span>
                                                            <span class="badge @relative.Status.ToString().ToLowerInvariant()">@relative.Status</span>
                                                            @if (relative.IsQueued)
                                                            {
                                                                <span class="badge queued" title="Already in Up Next">Queued</span>
                                                            }
                                                            <span class="muted">@RelativeMeta(relative)</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        }
                                        else
                                        {
                                            <p class="muted" aria-live="polite">Loading…</p>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Page.TotalCount > PageSize)
        {
            <div class="toolbar">
                <button @onclick="() => GoToPageAsync(0)" disabled="@(_query.Skip == 0)">First</button>
                <button @onclick="() => GoToPageAsync(_query.Skip - PageSize)" disabled="@(_query.Skip == 0)">Previous</button>
                <span class="muted">
                    @(_query.Skip + 1)–@Math.Min(_query.Skip + PageSize, Page.TotalCount) of @Page.TotalCount
                </span>
                <button @onclick="() => GoToPageAsync(_query.Skip + PageSize)"
                        disabled="@(_query.Skip + PageSize >= Page.TotalCount)">Next</button>
                <button @onclick="() => GoToPageAsync((Page.TotalCount - 1) / PageSize * PageSize)"
                        disabled="@(_query.Skip + PageSize >= Page.TotalCount)">Last</button>
            </div>
        }
    }
}

@code {
    private const int PageSize = 50;

    // Deliberately NOT persisted across the prerender handoff.
    //
    // Persisted state is serialised into the page, sent to the browser and posted
    // back when the circuit starts. A fifty-row page exceeds SignalR's default
    // 32KB receive limit, and the circuit then fails to start at all — the page
    // renders but nothing is interactive, with the failure visible only as a
    // socket close. Raising the limit would be treating the symptom: this would be
    // pushing tens of kilobytes through the browser to avoid one indexed query.
    public LibraryPage? Page { get; set; }

    // Facets are worth carrying: a handful of enums and counts, and they decide
    // which controls exist, so re-querying them causes the filter bar to change
    // shape after first paint.
    [PersistentState]
    public LibraryFacets? Facets { get; set; }

    private LibraryQuery _query = new() { Take = PageSize };
    private readonly HashSet<int> _selected = [];

    // How many relatives each visible row has, so a row with none draws no chevron
    // at all. One grouped query per page, loaded with it (D24).
    private IReadOnlyDictionary<int, int> _relatedCounts = new Dictionary<int, int>();

    // Which rows are open, and what they are showing. Detail is fetched on expand
    // rather than with the page: fifty rows' worth of relatives is a great deal of
    // data to fetch for the one row somebody opens.
    private readonly HashSet<int> _expanded = [];
    private readonly Dictionary<int, IReadOnlyList<RelatedTitle>> _relations = [];

    private string? _actionMessage;
    private BusyScope _busy = null!;

    private string _statusValue => _query.Status?.ToString() ?? string.Empty;

    private bool AllOnPageSelected =>
        Page is { Items.Count: > 0 } && Page.Items.All(i => _selected.Contains(i.AnimeId));

    protected override void OnInitialized() =>
        _busy = new BusyScope(() => InvokeAsync(StateHasChanged));

    protected override async Task OnInitializedAsync()
    {
        Facets ??= await LibraryService.GetFacetsAsync(Profile.DefaultProfileId);

        if (Page is null)
        {
            await LoadPageAsync();
        }
    }

    /// <summary>
    /// Loads the current query's page, and the one thing every row needs to know
    /// about its relatives: whether it has any.
    /// </summary>
    /// <remarks>
    /// Open expansions do not survive this. Reload, paging and every filter change
    /// come through here, and each of them means the rows on screen are a different
    /// set — a panel left open would be showing relatives of a title that has
    /// scrolled out of the result, which is worse than closing it.
    /// </remarks>
    private async Task LoadPageAsync()
    {
        Page = await LibraryService.GetPageAsync(Profile.DefaultProfileId, _query);

        _relatedCounts = await RelationService.GetRelatedCountsAsync(
            Profile.DefaultProfileId,
            [.. Page.Items.Select(i => i.AnimeId)]);

        _expanded.Clear();
        _relations.Clear();
    }

    /// <summary>
    /// Re-runs the current query, keeping the filters and the page the user is on.
    /// </summary>
    /// <remarks>
    /// The facets come back too: a background sync can add the first title of a
    /// decade or the first with a known runtime, and those decide which filter
    /// controls exist at all.
    /// </remarks>
    private async Task ReloadAsync()
    {
        Facets = await LibraryService.GetFacetsAsync(Profile.DefaultProfileId);
        await ApplyAsync(_query, resetPaging: false);
    }

    private async Task ApplyAsync(LibraryQuery query, bool resetPaging = true)
    {
        // Any change to what is being shown returns to the first page. Staying on
        // page four of a result set that no longer exists shows an empty table.
        _query = resetPaging ? query with { Skip = 0 } : query;
        await LoadPageAsync();
    }

    private Task OnSearchChangedAsync(ChangeEventArgs e) =>
        ApplyAsync(_query with { Search = e.Value?.ToString() });

    private Task OnStatusChangedAsync(ChangeEventArgs e) =>
        ApplyAsync(_query with
        {
            Status = Enum.TryParse<LibraryStatus>(e.Value?.ToString(), out var status) ? status : null
        });

    private Task OnSortChangedAsync(ChangeEventArgs e) =>
        ApplyAsync(_query with
        {
            Sort = Enum.TryParse<LibrarySort>(e.Value?.ToString(), out var sort) ? sort : LibrarySort.TitleAscending
        });

    private Task GoToPageAsync(int skip) =>
        ApplyAsync(_query with { Skip = Math.Max(0, skip) }, resetPaging: false);

    private Task ClearFiltersAsync() =>
        ApplyAsync(new LibraryQuery { Take = PageSize, Status = _query.Status });

    // Quick filters toggle: pressing an active chip clears it, so a chip is never
    // a trap the user has to hunt for a way out of.
    private Task ToggleRuntimeAsync(int minutes) =>
        ApplyAsync(_query with { MaxRuntimeMinutes = _query.MaxRuntimeMinutes == minutes ? null : minutes });

    private Task ToggleMediaTypeAsync(MediaType mediaType) =>
        ApplyAsync(_query with { MediaType = _query.MediaType == mediaType ? null : mediaType });

    private Task ToggleDecadeAsync(int decade) =>
        ApplyAsync(_query with { Decade = _query.Decade == decade ? null : decade });

    private Task ToggleSourceAsync(AnimeSource source) =>
        ApplyAsync(_query with { Source = _query.Source == source ? null : source });

    private Task ToggleHighConfidenceAsync() =>
        ApplyAsync(_query with
        {
            MinRecommendationConfidence = _query.MinRecommendationConfidence is null ? 0.7 : null
        });

    private Task ToggleUnrankedAsync() =>
        ApplyAsync(_query with { HasRecommendation = _query.HasRecommendation == false ? null : false });

    private Task ToggleHiddenAsync() =>
        ApplyAsync(_query with { IncludeHidden = !_query.IncludeHidden });

    private Task ToggleStandaloneAsync() =>
        ApplyAsync(_query with { StandaloneOnly = !_query.StandaloneOnly });

    private int? RelatedCount(int animeId) =>
        _relatedCounts.TryGetValue(animeId, out var count) ? count : null;

    private bool IsExpanded(int animeId) => _expanded.Contains(animeId);

    private static string RelatedRowId(int animeId) => $"related-{animeId}";

    /// <summary>
    /// Opens or closes a row's relatives, fetching them the first time.
    /// </summary>
    /// <remarks>
    /// Cached for as long as the page lasts, which is until any reload clears it.
    /// Collapsing and reopening the same row is a common way to compare two of
    /// them, and re-querying for it would make the second look slower than the
    /// first for no reason.
    ///
    /// Not routed through <see cref="BusyScope"/>: this is one small indexed read
    /// against a row already on screen, and a modal covering the page to report it
    /// would be far more disruptive than the wait it describes.
    /// </remarks>
    private async Task ToggleRelatedAsync(int animeId)
    {
        if (!_expanded.Add(animeId))
        {
            _expanded.Remove(animeId);
            return;
        }

        if (_relations.ContainsKey(animeId))
        {
            return;
        }

        _relations[animeId] = await RelationService.GetRelatedAsync(Profile.DefaultProfileId, animeId);
    }

    /// <summary>
    /// The accessible name of a chevron, which has to say whose relatives and how
    /// many — "expand", announced fifty times down a table, says neither.
    /// </summary>
    private static string RelatedLabel(LibraryListItem item, int count, bool expanded)
    {
        var verb = expanded ? "Hide" : "Show";

        return count == 1
            ? $"{verb} the one related title you own for {item.Title}"
            : $"{verb} the {count} related titles you own for {item.Title}";
    }

    /// <summary>
    /// The trailing detail on a relative: type, year, runtime, and progress where
    /// there is any. Absent parts are dropped rather than dashed — an expansion is
    /// prose beside a table, and a run of em dashes in it reads as damage.
    /// </summary>
    private static string RelativeMeta(RelatedTitle relative)
    {
        var parts = new List<string>(4);

        if (relative.MediaType != MediaType.Unknown)
        {
            parts.Add(MediaTypeLabel(relative.MediaType));
        }

        if (relative.ReleaseYear is { } year)
        {
            parts.Add(year.ToString(CultureInfo.InvariantCulture));
        }

        if (RuntimeCalculator.Format(relative.EstimatedRuntimeMinutes) is { } runtime)
        {
            parts.Add(runtime);
        }

        if (relative.EpisodesWatched > 0)
        {
            parts.Add(relative.EpisodeCount is { } total
                ? $"{relative.EpisodesWatched} / {total} watched"
                : $"{relative.EpisodesWatched} watched");
        }

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// How wide an expansion has to stretch. Derived rather than written down,
    /// because a hard-coded number is a colspan that silently goes wrong the next
    /// time a column is added.
    /// </summary>
    private int ColumnCount => Facets is { HasRecommendations: true } ? 10 : 9;

    private void ToggleSelection(int animeId)
    {
        if (!_selected.Remove(animeId))
        {
            _selected.Add(animeId);
        }

        _actionMessage = null;
    }

    private void ToggleSelectAll()
    {
        if (Page is null)
        {
            return;
        }

        if (AllOnPageSelected)
        {
            foreach (var item in Page.Items)
            {
                _selected.Remove(item.AnimeId);
            }
        }
        else
        {
            foreach (var item in Page.Items)
            {
                _selected.Add(item.AnimeId);
            }
        }

        _actionMessage = null;
    }

    private void ClearSelection()
    {
        _selected.Clear();
        _actionMessage = null;
    }

    private async Task AddSelectedToQueueAsync()
    {
        var ids = _selected.ToList();

        var result = await _busy.RunAsync(
            $"Adding {ids.Count} to Up Next",
            progress => QueueService.AddAnimeAsync(Profile.DefaultProfileId, ids, progress));

        _actionMessage = QueueAddText(result);

        await AfterBulkActionAsync();
    }

    private async Task SetSelectedHiddenAsync(bool hidden)
    {
        var ids = _selected.ToList();

        var result = await _busy.RunAsync(
            hidden ? $"Hiding {ids.Count}" : $"Restoring {ids.Count}",
            progress => LibraryService.SetHiddenAsync(Profile.DefaultProfileId, ids, hidden, progress));

        _actionMessage = hidden
            ? $"Hid {result.Affected} entries. They are still in your library."
            : $"Restored {result.Affected} entries.";

        await AfterBulkActionAsync();
    }

    private async Task AfterBulkActionAsync()
    {
        _selected.Clear();

        // Facets are refreshed too: hiding the last hidden entry, or priorities
        // appearing for the first time, changes which controls should be offered.
        Facets = await LibraryService.GetFacetsAsync(Profile.DefaultProfileId);
        await LoadPageAsync();
    }

    /// <summary>
    /// Reports what was added, and accounts for anything that was not.
    /// </summary>
    /// <remarks>
    /// Every reason is named. Selecting eight titles and being told five were added
    /// leaves the user to guess at the other three, and the likeliest guess — that
    /// the application dropped them — is the wrong one. This is reachable in normal
    /// use: the status filter widens the backlog past Planning, and Up Next only
    /// holds what is still planned.
    /// </remarks>
    private static string QueueAddText(QueueAddResult result)
    {
        var added = result.Added == 1
            ? "Added one title to Up Next."
            : $"Added {result.Added} titles to Up Next.";

        if (result.Skipped == 0)
        {
            return added;
        }

        var reasons = new List<string>();

        if (result.AlreadyQueued > 0)
        {
            reasons.Add($"{result.AlreadyQueued} already there");
        }

        if (result.NoLongerPlanned > 0)
        {
            reasons.Add($"{result.NoLongerPlanned} already started or finished");
        }

        if (result.Unavailable > 0)
        {
            reasons.Add($"{result.Unavailable} no longer in your library");
        }

        return $"{added} Skipped {result.Skipped}: {string.Join(", ", reasons)}.";
    }

    private static string Active(bool isActive) => isActive ? "active" : string.Empty;

    /// <summary>
    /// "80s" and "90s" read naturally; "00s" and "10s" do not, and "0s" — which a
    /// plain two-digit truncation produces for 2000 — is simply wrong. The brief
    /// spells the intended labels out: 80s, 90s, 2000s, 2010s, 2020s.
    /// </summary>
    private static string DecadeLabel(int decade) =>
        decade < 2000
            ? $"{decade % 100:00}s"
            : $"{decade}s";

    private static string MediaTypeLabel(MediaType mediaType) => mediaType switch
    {
        MediaType.Tv => "TV",
        MediaType.Ova => "OVA",
        MediaType.Ona => "ONA",
        _ => mediaType.ToString()
    };

    private string EntryCountText() =>
        Page is null ? string.Empty : $"{Page.TotalCount} {(Page.TotalCount == 1 ? "entry" : "entries")}";

    private static string ProgressText(LibraryListItem item) =>
        item.EpisodeCount is { } total
            ? $"{item.EpisodesWatched} / {total}"
            : item.EpisodesWatched > 0 ? item.EpisodesWatched.ToString() : "—";
}
