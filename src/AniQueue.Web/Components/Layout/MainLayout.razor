@inherits LayoutComponentBase
@using AniQueue.Infrastructure.Settings
@inject UserConfigStatus UserConfig

<div class="app">
    <header class="sidebar">
        <a class="brand" href="">AniQueue</a>

        @* Five destinations, which is what fits across a phone as a bottom bar with
           a readable label under each glyph. Getting there cost the
           Dashboard: it was six counters and no work, and the counters are a health
           check that belongs where the question is asked, on the backlog.

           A bar of links rather than a button opening a sheet. It needs no open
           state, no overlay and no focus trap, and five destinations do not earn
           that machinery. *@
        <nav aria-label="Main">
            <NavLink href="" Match="NavLinkMatch.All"><Icon Name="list-video" /><span>Up Next</span></NavLink>
            <NavLink href="backlog"><Icon Name="layers" /><span>Backlog</span></NavLink>
            <NavLink href="scoring"><Icon Name="sparkles" /><span>Scoring</span></NavLink>
            <NavLink href="sources"><Icon Name="plug" /><span>Sources</span></NavLink>
            <NavLink href="settings"><Icon Name="settings" /><span>Settings</span></NavLink>
        </nav>
    </header>

    <main>
        @* In the layout rather than on one page, because the application is running
           on incomplete settings wherever the user happens to be, and the operator
           is the only one who can change that. Dismissing it is an acknowledgement
           rather than a fix: it stays until somebody clears it, survives navigating
           between pages, and returns on the next load while the file is still
           unreadable. *@
        @if (UserConfig.IsBroken && !_configWarningDismissed)
        {
            <div class="notice error dismissible" role="alert">
                <button class="dismiss" @onclick="() => _configWarningDismissed = true"
                        aria-label="Dismiss the settings file warning"><Icon Name="x" /></button>

                <strong>Your settings file could not be read, so AniQueue started without it.</strong>
                Anything configured in <code>@UserConfig.Path</code> is being ignored — everything
                else, including <code>appsettings.json</code> and environment variables, is
                unaffected. Fix the file and restart to apply it.
                <div class="muted">@UserConfig.Error</div>
            </div>
        }

        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Layout state, so it outlives navigation: Blazor keeps one layout instance
    // across route changes, and a warning that reappeared on every click would be
    // noise rather than an acknowledgement. A full reload brings it back, which is
    // correct — that is a new session, and the file is still broken.
    private bool _configWarningDismissed;
}
