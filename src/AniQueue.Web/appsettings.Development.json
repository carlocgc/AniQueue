{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // On while developing, off in the image. These are the lines that say why a
      // task decided it had nothing to do and which filters a page ran, which is
      // what somebody watching this console is usually trying to find out.
      "AniQueue": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    // Local development writes inside the repository (git-ignored) rather than to
    // the container's /data volume, so the same code path works on both platforms.
    "Path": "./data/aniqueue.db"
  }
}
