{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Only the path, and only because it is the one setting userconfig.json cannot
  // hold: that file is found by looking beside the database, so a path set inside
  // it could not be read until it was already in use (D20).
  //
  // Every other user-facing key has been removed from this file. D36 makes
  // userconfig.json the one home for a setting, and a default belongs in the
  // options class that defines it rather than in a second layer that sets it —
  // otherwise a default improved in a later version is pinned by whatever this
  // file said when the installation was created.
  "Database": {
    "Path": "/data/aniqueue.db"
  }
}
