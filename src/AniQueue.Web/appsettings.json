{
  // Information carries what an operator needs in the ordinary case: what this
  // installation is configured to do at startup, and what every background task
  // did afterwards.
  //
  // AniQueue's own Debug level answers the questions Information cannot — why a
  // task decided it had nothing to do, which filters a backlog page ran, and why
  // an image came back 404. It is off by default because a busy page produces one
  // of those per row. Turn it on for one container without touching this file:
  //
  //     Logging__LogLevel__AniQueue=Debug
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "AniQueue": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Only the path, and only because it is the one setting userconfig.json cannot
  // hold: that file is found by looking beside the database, so a path set inside
  // it could not be read until it was already in use.
  //
  // Every other user-facing key is absent from this file:
  // userconfig.json is the one home for a setting, and a default belongs in the
  // options class that defines it rather than in a second layer that sets it —
  // otherwise a default improved in a later version is pinned by whatever this
  // file said when the installation was created.
  "Database": {
    "Path": "/data/aniqueue.db"
  }
}
